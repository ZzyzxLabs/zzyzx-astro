---
import Layout from "../../layouts/Layout.astro";
import WriteupIndex from "../../components/audit/WriteupIndex.astro";
import { getPublishedAudits } from "../../data/audits";

const records = await getPublishedAudits("incident");
---

<Layout
  title="Incident Analysis | Zzyzx Labs"
  description="Public smart contract exploits rebuilt from on-chain evidence: the vulnerable code, the transaction sequence, and the fix that would have prevented it."
  image={null}
  surface="audit"
>
  <WriteupIndex
    label="Incident analysis"
    tone="incident"
    heading="Past exploits, taken apart."
    empty="Incident writeups are being prepared."
    records={records}
  />
</Layout>
