---
import ScrollContinuum from "./ScrollContinuum.astro";

const services = [
  { name: "GTM & Growth", verb: "Position", description: "Positioning, KOL strategy, ecosystem activation, and launch.", href: "/gtm-growth" },
  { name: "Product Studio", verb: "Build", description: "Product strategy, experience design, smart contracts, backend, and AI.", href: "/product-studio" },
  { name: "Security Audit", verb: "Verify", description: "Manual review, AI-assisted analysis, adversarial testing, and formal verification.", href: "/security-audit" },
];

/**
 * Roles are the titles each operator states on their own profile page, and the
 * systems are the Zzyzx product lines those same pages claim. KC and Malingshu
 * have no profile page yet, so they keep their discipline line and carry no
 * system list rather than an attribution nobody has put their name to.
 */
const credits = [
  { name: "Frederic", role: "Co-Founder & CEO", href: "/frederic", systems: ["SeaWallet", "SeaPay", "Nereus"] },
  { name: "Zou", role: "CSO", href: "/zou", systems: ["SeaWallet", "Nereus"] },
  { name: "KC", role: "Backend infrastructure", systems: [] },
  { name: "Lun", role: "CTO", href: "/Lun", systems: ["SeaWallet", "SeaPay", "Nereus"] },
  { name: "Malingshu", role: "Applied AI", systems: [] },
];

// Newest work first. The proof section pins and hands off one project at a time as the scanline sweeps.
const proofProjects = [
  { name: "Sup Wallet", accent: "#3b3ad6", kind: "Agent economy", description: "An agentic, self-custodial wallet on Sui. Keys sign inside attested hardware, and agents act only inside the typed, capped, revocable allowances you grant.", href: "https://www.supwallet.app/", image: { src: "/supwallet-case.webp", width: 1792, height: 1008 } },
  { name: "Thru", accent: "#1a6047", kind: "Crypto payment infrastructure", description: "The payment rail for crypto businesses. Accept stablecoins across 25+ chains, with compliance and on-chain escrow built in.", href: "https://thru.la", image: { src: "/thru-case.webp", width: 1792, height: 1008 } },
  { name: "Broker", accent: "#a11f4c", kind: "Tokenized asset trading", description: "Trade tokenized stocks and cross-chain assets as broAssets on Sui, custodied 1:1 in Ika dWallets.", href: "https://trybroker.app", image: { src: "/broker-case.webp", width: 1792, height: 1008 } },
  { name: "Nereus", accent: "#784903", kind: "AI agents and TEE", description: "A prediction market using AI agents in trusted execution environments for decentralized outcome resolution.", href: "https://trynereus.xyz", image: { src: "/nereus-case.webp", width: 1737, height: 933 } },
  { name: "SeaWallet", accent: "#2b4a83", kind: "Smart account infrastructure", description: "Smart accounts for inheritance and asset distribution.", href: "https://SeaWallet.ai", image: { src: "/seawallet-case.webp", width: 1456, height: 816 } },
  { name: "SeaPay", accent: "#125780", kind: "Agent-ready payments", description: "x402 and A2A payments for AI-led travel booking.", href: "https://SeaPay.ai", image: { src: "/seapay-case.webp", width: 1792, height: 1008 } },
];

/**
 * Each product name is set in the ledger with its own brand mark: the capitals
 * take the product accent (sampled from that product’s own interface), the
 * lowercase stays ink. Runs are grouped so "SeaWallet" emits two spans, not ten.
 */
function nameRuns(name) {
  const runs = [];
  for (const char of name) {
    const cap = char >= "A" && char <= "Z";
    const last = runs[runs.length - 1];
    if (last && last.cap === cap) last.text += char;
    else runs.push({ cap, text: char });
  }
  return runs;
}

/** The ledger and the credit roll name the same products, so they read from one palette. */
const productAccent = new Map(proofProjects.map((project) => [project.name, project.accent]));

// Scroll budget for the pinned proof story, in viewport heights: a hold before and after every
// sweep, plus one sweep per hand-off. CSS sizes the spacer from these, the motion script reads them
// back off `data-proof-timeline`, so both stay derived from one place.
const PROOF_HOLD_VH = 1 / 6;
const PROOF_SWEEP_VH = 0.7;
const proofScrollVh = proofProjects.length * PROOF_HOLD_VH + (proofProjects.length - 1) * PROOF_SWEEP_VH;
const proofTimeline = `${PROOF_HOLD_VH}|${PROOF_SWEEP_VH}|${proofProjects.length}`;
---

<main class="home-v7" data-continuum-shell>
  <ScrollContinuum />

  <div class="folio" data-folio>
    <section id="home" class="hero-v7" data-scene-marker="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-position" data-hero-kicker>One-stop Web3 x AI solution provider</p>
          <h1 aria-label="Find the opening. Build with proof.">
            <span class="line-mask"><span data-hero-line>Find the opening.</span></span>
            <span class="line-mask"><span data-hero-line>Build with proof.</span></span>
          </h1>
          <div class="hero-support" data-hero-support>
            <p>GTM, product, and security for Web3 and AI teams.</p>
            <a class="ink-link" href="mailto:contact@zzyzx.com?subject=Start%20a%20brief">Start a brief <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <figure class="hero-media" data-hero-media aria-hidden="true">
          <img src="/zzyzx-ribbon-hero-v7.webp" alt="" width="1796" height="876" loading="eager" fetchpriority="high" />
          <figcaption>
            <span>Market signal</span>
            <span>Product system</span>
            <span>Verified release</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="work" class="work-v7" data-scene-marker="proof">
      <div
        class="proof-story"
        data-proof-story
        data-proof-timeline={proofTimeline}
        style={`--proof-story-vh: ${proofScrollVh}`}
      >
        <div class="proof-stage" data-proof-stage>
          <div class="proof-ledger">
            <header><h2>Selected systems</h2><p>Proof lives in what ships.</p></header>

            <div class="proof-deck" data-proof-deck>
              {proofProjects.map((project, index) => (
                <article class="proof-copy" data-proof-copy={index} data-active={index === 0 ? "true" : "false"} style={`--accent: ${project.accent};`}>
                  <p>{project.kind}</p>
                  <h3>{nameRuns(project.name).map((run) => (run.cap ? <span class="proof-name-cap">{run.text}</span> : run.text))}</h3>
                  <p>{project.description}</p>
                  <a class="ink-link" href={project.href} target="_blank" rel="noreferrer">Visit {project.name} <span aria-hidden="true">↗</span></a>
                </article>
              ))}
            </div>

            <ol class="proof-index" data-proof-index>
              {proofProjects.map((project, index) => (
                <li data-proof-index-item={index} data-active={index === 0 ? "true" : "false"} style={`--accent: ${project.accent};`}>
                  <span class="proof-index-num">{String(index + 1).padStart(2, "0")}</span>
                  <span class="proof-index-name">{nameRuns(project.name).map((run) => (run.cap ? <span class="proof-name-cap">{run.text}</span> : run.text))}</span>
                  <span class="proof-index-rule" aria-hidden="true"></span>
                </li>
              ))}
            </ol>

            <a class="ink-link portfolio-link" href="/portfolio">View portfolio <span aria-hidden="true">↗</span></a>
          </div>

          <figure class="proof-image" data-proof-image>
            <div class="proof-image-window">
              {proofProjects.map((project, index) => (
                <img
                  class="proof-frame"
                  data-proof-frame={index}
                  src={project.image.src}
                  alt={`${project.name} interface`}
                  width={project.image.width}
                  height={project.image.height}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              ))}
              <span class="witness-scan" data-witness-scan aria-hidden="true"></span>
            </div>
            <figcaption data-proof-caption>{proofProjects[0].name} interface, selected product work</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="solutions" class="services-v7" data-scene-marker="services">
      <header class="services-heading">
        <h2>Position. Build. Verify.</h2>
        <p>Three disciplines, one accountable delivery team.</p>
      </header>

      <div class="service-index" data-service-index>
        <svg class="service-pointer" data-service-pointer aria-hidden="true" focusable="false">
          <path
            data-service-pointer-path
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="butt"
            stroke-linejoin="miter"
          ></path>
        </svg>

        {services.map((service) => (
          <article class="service-row">
            <p class="service-verb">{service.verb}</p>
            <h3><a href={service.href}>{service.name}</a></h3>
            <p class="service-description">{service.description}</p>
            <span class="service-arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </section>

    <section id="about" class="studio-v7" data-scene-marker="studio">
      <header><h2>The operators behind the work.</h2></header>
      <div class="credit-roll" data-credit-roll>
        {credits.map((member) => (
          <div class="credit" data-credit>
            {member.href ? (
              <a class="credit-name" href={member.href}>{member.name}<span aria-hidden="true">↗</span></a>
            ) : (
              <span class="credit-name">{member.name}</span>
            )}
            <span class="credit-role">{member.role}</span>
            {member.systems.length > 0 && (
              <ul class="credit-systems" aria-label={`Systems ${member.name} has shipped`}>
                {member.systems.map((system) => (
                  <li style={`--accent: ${productAccent.get(system)};`}>{system}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="cta-v7" data-scene-marker="cta">
      <div class="cta-seal-space" data-cta-seal-anchor aria-hidden="true"></div>
      <div class="cta-copy" data-cta-copy>
        <h2><span class="line-mask"><span>Bring us the hard part.</span></span></h2>
        <a class="ink-link" href="mailto:contact@zzyzx.com?subject=Start%20a%20brief">Start a brief <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</main>

<script>
  import { mountServicePointer } from "../scripts/service-pointer";

  const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const pointerQuery = window.matchMedia("(pointer: fine)");

  let cleanup: (() => void) | null = null;

  const unmount = () => {
    cleanup?.();
    cleanup = null;
  };

  const mount = () => {
    unmount();
    // The arrow is a cursor affordance: no cursor, or no appetite for motion, no arrow.
    if (motionQuery.matches || !pointerQuery.matches) return;
    cleanup = mountServicePointer() ?? null;
  };

  document.addEventListener("astro:page-load", mount);
  motionQuery.addEventListener("change", mount);
  pointerQuery.addEventListener("change", mount);
  mount();

  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      document.removeEventListener("astro:page-load", mount);
      motionQuery.removeEventListener("change", mount);
      pointerQuery.removeEventListener("change", mount);
      unmount();
    });
  }
</script>

<style>
  .home-v7 {
    --black: #050607;
    --ink: #0a0c0d;
    --paper: #c9cdca;
    --paper-bright: #d8dcd8;
    --muted: #4c5557;
    --hairline: rgba(10, 12, 13, 0.2);
    --cyan: #16868d;
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    background: var(--black);
    color: var(--ink);
  }

  .folio { position: relative; width: 100%; background: var(--paper); }
  .line-mask { display: block; overflow: clip; padding-block: 0.02em 0.08em; }
  .line-mask > span { display: block; }

  .ink-link { display: inline-flex; width: fit-content; align-items: center; gap: 0.65rem; padding-bottom: 0.23rem; border-bottom: 1px solid var(--cyan); color: var(--ink); font-family: var(--font-heading), sans-serif; font-size: 0.86rem; font-weight: 600; line-height: 1.35; text-decoration: none; transition: border-color 180ms ease, color 180ms ease; }
  .ink-link:hover { border-color: var(--ink); color: #145e63; }
  .ink-link:focus-visible, .service-row a:focus-visible, .credit a:focus-visible { outline: 2px solid #0a565b; outline-offset: 5px; }

  .hero-v7 { min-height: 100dvh; padding-top: 4.25rem; }
  .hero-grid { display: grid; min-height: calc(100dvh - 4.25rem); grid-template-columns: minmax(0, 7fr) minmax(27rem, 5fr); }
  .hero-copy { position: relative; z-index: 6; display: grid; align-content: space-between; min-width: 0; padding: clamp(2rem, 4.2vw, 4.75rem) clamp(2rem, 4.8vw, 5.5rem) clamp(2.5rem, 5vw, 5rem); }
  .hero-position { margin: 0; color: #394143; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; line-height: 1.4; text-transform: uppercase; }
  .hero-copy h1 { align-self: end; margin: auto 0 0; font-family: var(--font-display), sans-serif; font-size: clamp(3.8rem, 6vw, 6.2rem); font-weight: 450; line-height: 0.86; letter-spacing: -0.068em; }
  .hero-support { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-top: clamp(2.5rem, 6vh, 5.5rem); padding-top: 1.4rem; border-top: 1px solid var(--hairline); }
  .hero-support p { max-width: 27rem; margin: 0; color: var(--muted); font-size: 1rem; line-height: 1.5; }
  .hero-media { position: relative; min-width: 0; min-height: 100%; margin: 0; overflow: hidden; background: #080a0b; }
  .hero-media::after { content: ""; position: absolute; inset: 0; border-left: 1px solid rgba(10, 12, 13, 0.28); pointer-events: none; }
  .hero-media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 56% center; }
  .hero-media figcaption { position: absolute; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255, 255, 255, 0.16); background: rgba(5, 6, 7, 0.88); color: #c9ceca; }
  .hero-media figcaption span { padding: 1rem 1.15rem; font-size: 0.66rem; letter-spacing: 0.045em; line-height: 1.3; }
  .hero-media figcaption span + span { border-left: 1px solid rgba(255, 255, 255, 0.13); }

  .work-v7 { border-top: 1px solid var(--hairline); }
  .proof-story { position: relative; }
  .proof-stage { position: relative; display: grid; min-height: calc(100dvh - 4.25rem); grid-template-columns: minmax(18rem, 3.4fr) minmax(0, 8.6fr); overflow: clip; background: var(--paper-bright); }
  .proof-ledger { position: relative; z-index: 6; display: grid; min-width: 0; align-content: space-between; padding: clamp(2rem, 4vw, 4.2rem) clamp(1.6rem, 3vw, 3.5rem); border-right: 1px solid var(--hairline); background: var(--paper-bright); }
  .proof-ledger header h2 { margin: 0; font-family: var(--font-display), sans-serif; font-size: clamp(2.4rem, 3.3vw, 3.6rem); font-weight: 470; line-height: 0.94; letter-spacing: -0.055em; }
  .proof-ledger header p { margin: 0.8rem 0 0; color: var(--muted); font-size: 0.88rem; }
  .proof-deck { display: grid; }
  .proof-copy > p:first-child { margin: 0; color: #444d4f; font-size: 0.69rem; line-height: 1.4; }
  .proof-copy h3 { margin: 0.5rem 0 0; font-family: var(--font-display), sans-serif; font-size: clamp(2.6rem, 4vw, 4.4rem); font-weight: 470; line-height: 0.9; letter-spacing: -0.06em; }
  /* Accent rides the capitals only, so the paper stays quiet and each project still arrives in its own colour. */
  .proof-name-cap { transition: color 240ms ease; }
  .proof-copy h3 .proof-name-cap { color: var(--accent, inherit); }
  .proof-copy > p:nth-of-type(2) { max-width: 30rem; margin: 1rem 0 0; color: var(--muted); font-size: 0.82rem; line-height: 1.5; }
  .proof-copy .ink-link { margin-top: 1.25rem; }
  .proof-index { margin: 0; padding: 0; list-style: none; }
  .portfolio-link { margin-top: 1.4rem; }
  .proof-image { position: relative; z-index: 2; display: grid; min-width: 0; margin: 0; padding: clamp(2rem, 4vw, 4rem); align-content: center; background: #b9beb9; }
  .proof-image-window { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid rgba(10, 12, 13, 0.28); background: #08101d; }
  .proof-frame { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .proof-image figcaption { margin-top: 0.8rem; color: #374143; font-size: 0.68rem; line-height: 1.35; }
  .witness-scan { position: absolute; z-index: 3; top: 0; bottom: 0; left: 0; display: block; width: 3px; background: linear-gradient(180deg, rgba(107, 209, 215, 0.3), #8ef0f6 16%, #8ef0f6 84%, rgba(107, 209, 215, 0.3)); box-shadow: 0 0 3px 1px rgba(255, 255, 255, 0.95), 0 0 26px 7px rgba(22, 134, 141, 0.55); opacity: 0; }

  /* Static fallback: the deck reads as a feature plus a compact ledger list, one image, no sweep. */
  @media (max-width: 1023px), (max-height: 639px) {
    .proof-deck > .proof-copy:first-child { margin-top: auto; padding-top: clamp(2rem, 7vh, 5rem); }
    .proof-deck > .proof-copy:nth-child(2) { margin-top: clamp(2rem, 5vh, 3.5rem); border-top: 1px solid var(--hairline); }
    .proof-deck > .proof-copy + .proof-copy { padding: 1rem 0; border-bottom: 1px solid var(--hairline); }
    .proof-deck > .proof-copy + .proof-copy h3 { font-family: var(--font-heading), sans-serif; font-size: 1rem; font-weight: 600; line-height: 1.3; letter-spacing: normal; }
    .proof-deck > .proof-copy + .proof-copy > p:nth-of-type(2) { font-size: 0.72rem; }
    .proof-deck > .proof-copy + .proof-copy .ink-link { margin-top: 0.65rem; font-size: 0.72rem; }
    .proof-index { display: none; }
    .proof-frame:not(:first-child) { display: none; }
    .witness-scan { display: none; }
  }

  .services-v7 { --edge: clamp(2rem, 4.6vw, 5.5rem); position: relative; padding: clamp(6.5rem, 13vh, 10rem) var(--edge); border-top: 1px solid var(--hairline); background: var(--paper); }
  .services-heading { display: grid; grid-template-columns: minmax(0, 8fr) minmax(16rem, 4fr); align-items: end; gap: 2rem; padding-bottom: clamp(4rem, 9vh, 7rem); }
  .services-heading h2 { position: relative; z-index: 6; margin: 0; font-family: var(--font-display), sans-serif; font-size: clamp(3.5rem, 6.8vw, 7rem); font-weight: 450; line-height: 0.84; letter-spacing: -0.074em; }
  .services-heading p { position: relative; z-index: 6; max-width: 23rem; margin: 0 0 0.35rem; color: var(--muted); font-size: 0.96rem; line-height: 1.5; }
  .service-index { position: relative; border-top: 1px solid var(--hairline); }
  /* The arrow rides the section's left gutter, so the list keeps its full-bleed rules. */
  .service-pointer { position: absolute; z-index: 6; top: 0; left: calc(-1 * var(--edge)); width: var(--edge); height: 100%; color: var(--ink); opacity: 0; pointer-events: none; }
  .service-row { position: relative; display: grid; min-height: clamp(12rem, 24dvh, 16rem); grid-template-columns: 1.4fr 3.3fr 4.2fr 0.55fr; align-items: center; gap: clamp(1.25rem, 3vw, 3rem); border-bottom: 1px solid var(--hairline); color: var(--ink); }
  .service-row > * { position: relative; z-index: 6; }
  .service-verb { margin: 0; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .service-row h3 { margin: 0; font-family: var(--font-display), sans-serif; font-size: clamp(2.3rem, 3.8vw, 4rem); font-weight: 470; line-height: 0.92; letter-spacing: -0.058em; }
  .service-row h3 a, .service-arrow { color: inherit; text-decoration: none; }
  .service-description { max-width: 34rem; margin: 0; color: #4d5557; font-size: 0.9rem; line-height: 1.5; }
  .service-arrow { justify-self: end; font-size: 1.25rem; }

  .studio-v7 { position: relative; z-index: 6; padding: clamp(6rem, 12vh, 9rem) clamp(2rem, 4.6vw, 5.5rem); background: var(--paper); }
  .studio-v7 > header { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .studio-v7 h2 { grid-column: 1 / 8; max-width: 14ch; margin: 0; font-family: var(--font-display), sans-serif; font-size: clamp(2.8rem, 4.8vw, 5rem); font-weight: 460; line-height: 0.92; letter-spacing: -0.062em; }
  .credit-roll { display: grid; margin-top: clamp(4rem, 9vh, 7rem); grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--hairline); }
  .credit { display: grid; min-width: 0; align-content: start; gap: 0.6rem; padding: 1.5rem clamp(0.6rem, 1.5vw, 1.4rem) 1.9rem; }
  .credit + .credit { border-left: 1px solid var(--hairline); }
  .credit-name { width: fit-content; color: var(--ink); font-family: var(--font-heading), sans-serif; font-size: clamp(1.1rem, 1.55vw, 1.45rem); font-weight: 600; letter-spacing: -0.035em; text-decoration: none; }
  /* Two of these names open a profile and three do not; they used to look identical.
     The link now carries the cyan rule and arrow every other link on this page uses. */
  a.credit-name { display: inline-flex; align-items: baseline; gap: 0.35rem; padding-bottom: 0.15rem; border-bottom: 1px solid var(--cyan); transition: border-color 180ms ease, color 180ms ease; }
  a.credit-name span { font-size: 0.62em; }
  a.credit-name:hover { border-color: var(--ink); color: #145e63; }
  .credit-role { max-width: 15rem; color: var(--muted); font-size: 0.72rem; line-height: 1.4; }
  /* The systems each operator shipped, in the colours those products carry in the
     ledger above, so the roll is evidence rather than an assertion. */
  .credit-systems { display: flex; flex-wrap: wrap; gap: 0.3rem 0.8rem; margin: 0.5rem 0 0; padding: 0; list-style: none; }
  .credit-systems li { color: var(--accent); font-family: var(--font-heading), sans-serif; font-size: 0.73rem; font-weight: 600; letter-spacing: -0.012em; }

  .cta-v7 { position: relative; display: grid; min-height: 68dvh; grid-template-columns: 4fr 8fr; align-items: center; padding: clamp(5rem, 10vh, 8rem) clamp(2rem, 4.6vw, 5.5rem); border-top: 1px solid var(--hairline); background: var(--paper); }
  .cta-seal-space { min-height: 16rem; }
  .cta-copy { position: relative; z-index: 6; padding-left: clamp(1.5rem, 4vw, 4rem); border-left: 1px solid var(--hairline); }
  .cta-copy h2 { max-width: 12ch; margin: 0; font-family: var(--font-display), sans-serif; font-size: clamp(3rem, 5.5vw, 5.6rem); font-weight: 460; line-height: 0.88; letter-spacing: -0.068em; }
  .cta-copy .ink-link { margin-top: clamp(2rem, 5vh, 3.5rem); font-size: 1rem; }

  /* Pinned proof story: one project at a time, the scanline wipes the next one in.
     Every vertical metric is viewport-height driven so the ledger fits real browser
     viewports (which sit well under the screen height) without clipping. */
  @media (min-width: 1024px) and (min-height: 640px) {
    .proof-story { min-height: calc(100dvh * (1 + var(--proof-story-vh, 4.5))); }
