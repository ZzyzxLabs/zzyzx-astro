---
import ScrollContinuum from "./ScrollContinuum.astro";

const services = [
  { name: "GTM & Growth", verb: "Position", description: "Positioning, KOL strategy, ecosystem activation, and launch.", href: "/gtm-growth" },
  { name: "Product Studio", verb: "Build", description: "Product strategy, experience design, smart contracts, backend, and AI.", href: "/product-studio" },
  { name: "Security Audit", verb: "Verify", description: "Manual review, AI-assisted analysis, adversarial testing, and formal verification.", href: "/security-audit" },
];

const credits = [
  { name: "Frederic", role: "Architecture and engineering", href: "/frederic" },
  { name: "Zou", role: "Strategy and product", href: "/zou" },
  { name: "KC", role: "Backend infrastructure" },
  { name: "Lun", role: "Creative direction" },
  { name: "Malingshu", role: "Applied AI" },
];

const proofCredits = [
  { name: "SeaWallet", kind: "Smart account infrastructure", description: "Smart accounts for inheritance and asset distribution.", href: "https://SeaWallet.ai" },
  { name: "SeaPay", kind: "Agent-ready payments", description: "x402 and A2A payments for AI-led travel booking.", href: "https://SeaPay.ai" },
];
---

<main class="home-v7" data-continuum-shell>
  <ScrollContinuum />

  <div class="folio" data-folio>
    <section id="home" class="hero-v7" data-scene-marker="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-position" data-hero-kicker>One-stop Web3 x AI solution provider</p>
          <h1 aria-label="Find the opening. Build with proof.">
            <span class="line-mask"><span data-hero-line>Find the opening.</span></span>
            <span class="line-mask"><span data-hero-line>Build with proof.</span></span>
          </h1>
          <div class="hero-support" data-hero-support>
            <p>GTM, product, and security for Web3 and AI teams.</p>
            <a class="ink-link" href="mailto:contact@zzyzx.com?subject=Start%20a%20brief">Start a brief <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <figure class="hero-media" data-hero-media aria-hidden="true">
          <img src="/zzyzx-ribbon-hero-v7.webp" alt="" width="1796" height="876" loading="eager" fetchpriority="high" />
          <figcaption>
            <span>Market signal</span>
            <span>Product system</span>
            <span>Verified release</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="work" class="work-v7" data-scene-marker="proof">
      <div class="proof-story" data-proof-story>
        <div class="proof-stage" data-proof-stage>
          <div class="proof-ledger">
            <header><h2>Selected systems</h2><p>Proof lives in what ships.</p></header>

            <article class="lead-proof-copy">
              <p>AI agents and TEE</p>
              <h3>Nereus</h3>
              <p>A prediction market using AI agents in trusted execution environments for decentralized outcome resolution.</p>
              <a class="ink-link" href="https://trynereus.xyz" target="_blank" rel="noreferrer">Visit Nereus <span aria-hidden="true">↗</span></a>
            </article>

            <div class="proof-credit-list">
              {proofCredits.map((project) => (
                <article>
                  <p>{project.kind}</p>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                  <a href={project.href} target="_blank" rel="noreferrer" aria-label={`Visit ${project.name}`}><span aria-hidden="true">↗</span></a>
                </article>
              ))}
            </div>
            <a class="ink-link portfolio-link" href="/portfolio">View portfolio <span aria-hidden="true">↗</span></a>
          </div>

          <figure class="proof-image" data-proof-image>
            <div class="proof-image-window">
              <img src="/nereus-case.webp" alt="Nereus prediction market interface" width="1737" height="933" loading="lazy" />
              <span class="witness-scan" data-witness-scan aria-hidden="true"></span>
            </div>
            <figcaption>Nereus interface, selected product work</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="solutions" class="services-v7" data-scene-marker="services">
      <header class="services-heading">
        <h2>Position. Build. Verify.</h2>
        <p>Three disciplines, one accountable delivery team.</p>
      </header>

      <div class="service-index">
        {services.map((service, index) => (
          <article class="service-row" data-service-row={index}>
            <span class="service-wipe" aria-hidden="true"></span>
            <p class="service-verb">{service.verb}</p>
            <h3><a href={service.href}>{service.name}</a></h3>
            <p class="service-description">{service.description}</p>
            <span class="service-arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </section>

    <section id="approach" class="handoff-v7" data-scene-marker="approach">
      <div class="handoff-heading"><h2>One feedback loop.</h2><p>No strategic handoff between demand, delivery, and verification.</p></div>
      <ol class="handoff-steps" data-handoff-steps>
        <li><span>Find demand</span><p>A position the market can repeat.</p></li>
        <li><span>Build the system</span><p>A release shaped by real constraints.</p></li>
        <li><span>Verify the release</span><p>Evidence for paths that carry value.</p></li>
      </ol>
      <span class="handoff-progress" data-handoff-progress aria-hidden="true"></span>
    </section>

    <section id="about" class="studio-v7" data-scene-marker="studio">
      <header><h2>The operators behind the work.</h2></header>
      <div class="credit-roll" data-credit-roll>
        {credits.map((member) => (
          <div class="credit" data-credit>
            {member.href ? <a href={member.href}>{member.name}</a> : <span>{member.name}</span>}
            <span>{member.role}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="cta-v7" data-scene-marker="cta">
      <div class="cta-seal-space" data-cta-seal-anchor aria-hidden="true"></div>
      <div class="cta-copy" data-cta-copy>
        <h2><span class="line-mask"><span>Bring us the hard part.</span></span></h2>
        <a class="ink-link" href="mailto:contact@zzyzx.com?subject=Start%20a%20brief">Start a brief <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</main>

<style>
  .home-v7 {
    --black: #050607;
    --ink: #0a0c0d;
    --paper: #c9cdca;
    --paper-bright: #d8dcd8;
    --muted: #4c5557;
    --hairline: rgba(10, 12, 13, 0.2);
    --cyan: #16868d;
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    background: var(--black);
    color: var(--ink);
  }

  .folio { position: relative; width: 93vw; margin-left: 7vw; background: var(--paper); box-shadow: -1px 0 0 rgba(216, 220, 216, 0.2); }
  .line-mask { display: block; overflow: clip; padding-block: 0.02em 0.08em; }
  .line-mask > span { display: block; }

  .ink-link { display: inline-flex; width: fit-content; align-items: center; gap: 0.65rem; padding-bottom: 0.23rem; border-bottom: 1px solid var(--cyan); color: var(--ink); font-family: var(--font-heading), sans-serif; font-size: 0.86rem; font-weight: 600; line-height: 1.35; text-decoration: none; transition: border-color 180ms ease, color 180ms ease; }
  .ink-link:hover { border-color: var(--ink); color: #145e63; }
  .ink-link:focus-visible, .service-row a:focus-visible, .credit a:focus-visible { outline: 2px solid #0a565b; outline-offset: 5px; }

  .hero-v7 { min-height: 100dvh; padding-top: 4.25rem; }
  .hero-grid { display: grid; min-height: calc(100dvh - 4.25rem); grid-template-columns: minmax(0, 7fr) minmax(27rem, 5fr); }
  .hero-copy { position: relative; z-index: 6; display: grid; align-content: space-between; min-width: 0; padding: clamp(2rem, 4.2vw, 4.75rem) clamp(2rem, 4.8vw, 5.5rem) clamp(2.5rem, 5vw, 5rem); }
  .hero-position { margin: 0; color: #394143; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; line-height: 1.4; text-transform: uppercase; }
  .hero-copy h1 { align-self: end; margin: auto 0 0; font-family: var(--font-display), sans-serif; font-size: clamp(3.8rem, 6vw, 6.2rem); font-weight: 450; line-height: 0.86; letter-spacing: -0.068em; }
  .hero-support { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-top: clamp(2.5rem, 6vh, 5.5rem); padding-top: 1.4rem; border-top: 1px solid var(--hairline); }
  .hero-support p { max-width: 27rem; margin: 0; color: var(--muted); font-size: 1rem; line-height: 1.5; }
  .hero-media { position: relative; min-width: 0; min-height: 100%; margin: 0; overflow: hidden; background: #080a0b; }
  .hero-media::after { content: ""; position: absolute; inset: 0; border-left: 1px solid rgba(10, 12, 13, 0.28); pointer-events: none; }
  .hero-media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 56% center; }
  .hero-media figcaption { position: absolute; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255, 255, 255, 0.16); background: rgba(5, 6, 7, 0.88); color: #c9ceca; }
  .hero-media figcaption span { padding: 1rem 1.15rem; font-size: 0.66rem; letter-spacing: 0.045em; line-height: 1.3; }
  .hero-media figcaption span + span { border-left: 1px solid rgba(255, 255, 255, 0.13); }

  .work-v7 { border-top: 1px solid var(--hairline); }
  .proof-story { min-height: 0; }
  .proof-stage { position: relative; display: grid; min-height: calc(100dvh - 4.25rem); grid-template-columns: minmax(18rem, 3.4fr) minmax(0, 8.6fr); overflow: hidden; background: var(--paper-bright); }
  .proof-ledger { position: relative; z-index: 6; display: grid; min-width: 0; align-content: space-between; padding: clamp(2rem, 4vw, 4.2rem) clamp(1.6rem, 3vw, 3.5rem); border-right: 1px solid var(--hairline); background: var(--paper-bright); }
  .proof-ledger header h2 { margin: 0; font-family: var(--font-display), sans-serif; font-size: clamp(2.4rem, 3.3vw, 3.6rem); font-weight: 470; line-height: 0.94; letter-spacing: -0.055em; }
  .proof-ledger header p { margin: 0.8rem 0 0; color: var(--muted); font-size: 0.88rem; }
  .lead-proof-copy { margin-top: auto; padding-top: clamp(2rem, 7vh, 5rem); }
  .lead-proof-copy > p:first-child, .proof-credit-list article > p:first-child { margin: 0; color: #444d4f; font-size: 0.69rem; line-height: 1.4; }
  .lead-proof-copy h3 { margin: 0.5rem 0 0; font-family: var(--font-display), sans-serif; font-size: clamp(2.6rem, 4vw, 4.4rem); font-weight: 470; line-height: 0.9; letter-spacing: -0.06em; }
  .lead-proof-copy > p:nth-of-type(2) { max-width: 30rem; margin: 1rem 0 0; color: var(--muted); font-size: 0.82rem; line-height: 1.5; }
  .lead-proof-copy .ink-link { margin-top: 1.25rem; }
  .proof-credit-list { display: grid; margin-top: clamp(2rem, 5vh, 3.5rem); border-top: 1px solid var(--hairline); }
  .proof-credit-list article { position: relative; display: grid; grid-template-columns: 1fr auto; padding: 1rem 2.25rem 1rem 0; border-bottom: 1px solid var(--hairline); }
  .proof-credit-list article > p:first-child { grid-column: 1 / -1; }
  .proof-credit-list h3 { margin: 0.35rem 0 0; font-family: var(--font-heading), sans-serif; font-size: 1rem; font-weight: 600; }
  .proof-credit-list article > p:nth-of-type(2) { grid-column: 1 / -1; margin: 0.35rem 0 0; color: var(--muted); font-size: 0.72rem; line-height: 1.4; }
  .proof-credit-list a { position: absolute; right: 0; bottom: 0.95rem; color: var(--ink); text-decoration: none; }
  .portfolio-link { margin-top: 1.4rem; }
  .proof-image { position: relative; z-index: 2; display: grid; min-width: 0; margin: 0; padding: clamp(2rem, 4vw, 4rem); align-content: center; background: #b9beb9; }
  .proof-image-window { position: relative; overflow: hidden; border: 1px solid rgba(10, 12, 13, 0.28); background: #08101d; }
  .proof-image img { display: block; width: 100%; height: auto; aspect-ratio: 1737 / 933; object-fit: cover; transform-origin: center center; }
  .proof-image figcaption { margin-top: 0.8rem; color: #374143; font-size: 0.68rem; line-height: 1.35; }
  .witness-scan { position: absolute; z-index: 3; top: 0; bottom: 0; left: 0; display: block; width: 2px; background: #6bd1d7; opacity: 0; transform: translate3d(-100%, 0, 0); }

  .services-v7 { position: relative; padding: clamp(6.5rem, 13vh, 10rem) clamp(2rem, 4.6vw, 5.5rem); border-top: 1px solid var(--hairline); background: var(--paper); }
  .services-heading { display: grid; grid-template-columns: minmax(0, 8fr) minmax(16rem, 4fr); align-items: end; gap: 2rem; padding-bottom: clamp(4rem, 9vh, 7rem); }
  .services-heading h2 { position: relative; z-index: 6; margin: 0; font-family: var(--font-display), sans-serif; font-size: clamp(3.5rem, 6.8vw, 7rem); font-weight: 450; line-height: 0.84; letter-spacing: -0.074em; }
  .services-heading p { position: relative; z-index: 6; max-width: 23rem; margin: 0 0 0.35rem; color: var(--muted); font-size: 0.96rem; line-height: 1.5; }
  .service-index { border-top: 1px solid var(--hairline); }
  .service-row { position: relative; display: grid; min-height: clamp(12rem, 24dvh, 16rem); grid-template-columns: 1.4fr 3.3fr 4.2fr 0.55fr; align-items: center; gap: clamp(1.25rem, 3vw, 3rem); overflow: hidden; border-bottom: 1px solid var(--hairline); color: var(--ink); }
  .service-row > :not(.service-wipe) { position: relative; z-index: 6; }
  .service-wipe { position: absolute; z-index: 1; top: 0; bottom: 0; left: 0; display: block; width: clamp(7rem, 10vw, 9rem); background: var(--ink); transform: scaleX(0); transform-origin: left center; }
  .service-verb { margin: 0; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .service-row h3 { margin: 0; font-family: var(--font-display), sans-serif; font-size: clamp(2.3rem, 3.8vw, 4rem); font-weight: 470; line-height: 0.92; letter-spacing: -0.058em; }
  .service-row h3 a, .service-arrow { color: inherit; text-decoration: none; }
  .service-description { max-width: 34rem; margin: 0; color: #4d5557; font-size: 0.9rem; line-height: 1.5; }
  .service-arrow { justify-self: end; font-size: 1.25rem; }
  .service-row[data-active="true"] .service-verb { color: #75d3d8; }
  .service-row[data-active="true"] .service-arrow { color: var(--cyan); }

  .handoff-v7 { position: relative; display: grid; min-height: 58dvh; grid-template-columns: minmax(16rem, 4fr) minmax(0, 8fr); align-items: center; gap: clamp(3rem, 6vw, 7rem); padding: clamp(5rem, 10vh, 8rem) clamp(2rem, 4.6vw, 5.5rem); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); background: var(--paper); }
  .handoff-heading, .handoff-steps { position: relative; z-index: 6; }
  .handoff-heading h2 { margin: 0; font-family: var(--font-display), sans-serif; font-size: clamp(2.7rem, 4.4vw, 4.8rem); font-weight: 460; line-height: 0.9; letter-spacing: -0.06em; }
  .handoff-heading p { max-width: 27rem; margin: 1.15rem 0 0; color: var(--muted); font-size: 0.9rem; line-height: 1.5; }
  .handoff-steps { display: grid; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hairline); }
  .handoff-steps li { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2rem; padding: 1.35rem 0; border-bottom: 1px solid var(--hairline); }
  .handoff-steps span { font-family: var(--font-heading), sans-serif; font-size: clamp(1.25rem, 2vw, 1.8rem); font-weight: 500; letter-spacing: -0.035em; }
  .handoff-steps p { margin: 0; color: var(--muted); font-size: 0.8rem; line-height: 1.45; }
  .handoff-progress { position: absolute; z-index: 7; top: -1px; left: 0; display: block; width: 100%; height: 2px; background: var(--cyan); transform: scaleX(0); transform-origin: left center; }

  .studio-v7 { position: relative; z-index: 6; padding: clamp(6rem, 12vh, 9rem) clamp(2rem, 4.6vw, 5.5rem); background: var(--paper); }
  .studio-v7 > header { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .studio-v7 h2 { grid-column: 1 / 8; max-width: 14ch; margin: 0; font-family: var(--font-display), sans-serif; font-size: clamp(2.8rem, 4.8vw, 5rem); font-weight: 460; line-height: 0.92; letter-spacing: -0.062em; }
  .credit-roll { display: grid; margin-top: clamp(4rem, 9vh, 7rem); grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--hairline); }
  .credit { display: grid; min-width: 0; gap: 0.65rem; padding: 1.5rem clamp(0.6rem, 1.5vw, 1.4rem) 0; }
  .credit + .credit { border-left: 1px solid var(--hairline); }
  .credit > :first-child { color: var(--ink); font-family: var(--font-heading), sans-serif; font-size: clamp(1.1rem, 1.55vw, 1.45rem); font-weight: 600; letter-spacing: -0.035em; text-decoration: none; }
  .credit > :last-child { max-width: 15rem; color: var(--muted); font-size: 0.72rem; line-height: 1.4; }

  .cta-v7 { position: relative; display: grid; min-height: 68dvh; grid-template-columns: 4fr 8fr; align-items: center; padding: clamp(5rem, 10vh, 8rem) clamp(2rem, 4.6vw, 5.5rem); border-top: 1px solid var(--hairline); background: var(--paper); }
  .cta-seal-space { min-height: 16rem; }
  .cta-copy { position: relative; z-index: 6; padding-left: clamp(1.5rem, 4vw, 4rem); border-left: 1px solid var(--hairline); }
  .cta-copy h2 { max-width: 12ch; margin: 0; font-family: var(--font-display), sans-serif; font-size: clamp(3rem, 5.5vw, 5.6rem); font-weight: 460; line-height: 0.88; letter-spacing: -0.068em; }
  .cta-copy .ink-link { margin-top: clamp(2rem, 5vh, 3.5rem); font-size: 1rem; }

  @media (min-width: 1024px) and (min-height: 700px) and (pointer: fine) {
    .home-v7[data-continuum-status="ready"] .proof-story { min-height: 145dvh; }
    .home-v7[data-continuum-status="ready"] .proof-stage { position: sticky; top: 4.25rem; height: calc(100dvh - 4.25rem); min-height: 0; }
  }

  @media (max-width: 1023px) {
    .folio { width: 100%; margin-left: 0; }
    .hero-grid { grid-template-columns: minmax(0, 1.15fr) minmax(21rem, 0.85fr); }
    .proof-stage { grid-template-columns: minmax(16rem, 4fr) minmax(0, 8fr); }
    .services-heading { grid-template-columns: 1fr; }
    .services-heading p { margin: 0; }
    .service-row { grid-template-columns: 1fr 2.8fr 3.5fr auto; }
    .credit-roll { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }

  @media (min-width: 768px) and (max-width: 899px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy { min-height: calc(72dvh - 4.25rem); }
    .hero-media { min-height: 54dvh; }
  }

  @media (max-width: 767px) {
    .hero-v7 { min-height: auto; }
    .hero-grid { min-height: auto; grid-template-columns: 1fr; }
    .hero-copy { min-height: 38rem; padding: 1.6rem 1.15rem 2rem; }
    .hero-copy h1 { font-size: clamp(3rem, 13vw, 4.25rem); line-height: 0.94; }
    .hero-copy .line-mask { padding-bottom: 0.16em; }
    .hero-support { display: grid; gap: 1.25rem; margin-top: 2.5rem; }
    .hero-media { min-height: 44dvh; }
    .hero-media figcaption { grid-template-columns: 1fr; }
    .hero-media figcaption span { padding: 0.65rem 0.8rem; }
    .hero-media figcaption span + span { border-top: 1px solid rgba(255, 255, 255, 0.1); border-left: 0; }
    .proof-story { min-height: 0; }
    .proof-stage { position: relative; top: auto; height: auto; grid-template-columns: 1fr; overflow: visible; }
    .proof-ledger { display: contents; }
    .proof-ledger > header { grid-row: 1; padding: 4.75rem 1.15rem 2.75rem; background: var(--paper-bright); }
    .proof-image { grid-row: 2; padding: 1.15rem; }
    .proof-image figcaption { margin-top: 0.65rem; }
    .lead-proof-copy { grid-row: 3; margin: 0; padding: 3.5rem 1.15rem 2.5rem; background: var(--paper-bright); }
    .proof-credit-list { grid-row: 4; margin: 0; padding-inline: 1.15rem; background: var(--paper-bright); }
    .portfolio-link { grid-row: 5; margin: 1.75rem 1.15rem 4.75rem; }
    .services-v7, .studio-v7 { padding: 5.5rem 1.15rem; }
    .services-heading { gap: 1.4rem; padding-bottom: 4rem; }
    .services-heading h2 { font-size: clamp(3.3rem, 15vw, 5.2rem); }
    .service-row { min-height: 0; grid-template-columns: 1fr auto; gap: 1rem; padding: 2.25rem 0; }
    .service-verb { grid-column: 1 / -1; }
    .service-row h3 { grid-column: 1; font-size: clamp(2.3rem, 10vw, 3.25rem); }
    .service-arrow { grid-column: 2; grid-row: 2; }
    .service-description { grid-column: 1 / -1; }
    .service-wipe { display: none; }
    .service-row[data-active="true"] { color: var(--ink); }
    .service-row[data-active="true"] .service-description { color: var(--muted); }
    .service-row[data-active="true"] .service-verb { color: inherit; }
    .handoff-v7 { min-height: 0; grid-template-columns: 1fr; gap: 4rem; padding: 5.5rem 1.15rem; }
    .handoff-steps li { grid-template-columns: 1fr; gap: 0.65rem; }
    .studio-v7 > header { display: block; }
    .studio-v7 h2 { font-size: clamp(2.9rem, 12vw, 4rem); }
    .credit-roll { grid-template-columns: 1fr; margin-top: 4rem; }
    .credit { padding: 1.25rem 0; border-bottom: 1px solid var(--hairline); }
    .credit + .credit { border-left: 0; }
    .cta-v7 { min-height: 66dvh; grid-template-columns: 1fr; padding: 5.5rem 1.15rem; }
    .cta-seal-space { min-height: 12rem; }
    .cta-copy { padding: 2rem 0 0; border-top: 1px solid var(--hairline); border-left: 0; }
    .cta-copy h2 { font-size: clamp(3rem, 14vw, 4.5rem); }
  }

  @media (prefers-reduced-motion: reduce) { .ink-link { transition: none; } }
</style>
