---
import ScrollContinuum from "./ScrollContinuum.astro";

const capabilities = [
  {
    name: "GTM and growth",
    headline: "Enter the market with a position people can repeat.",
    description:
      "We turn market research into clear positioning, KOL strategy, ecosystem activation, and a launch system built for adoption.",
    outputs: ["Market thesis", "KOL mapping", "Growth strategy", "Launch execution"],
    href: "/gtm-growth",
    cta: "Explore GTM & Growth",
    layout: "left",
  },
  {
    name: "Product studio",
    headline: "Ship a product that holds up outside the demo.",
    description:
      "Product strategy, experience design, smart contracts, backend systems, and AI integrations stay inside one delivery team.",
    outputs: ["Product strategy", "UX and brand", "Full-stack delivery", "Web3 and AI"],
    href: "/product-studio",
    cta: "Explore Product Studio",
    layout: "right",
  },
  {
    name: "Security and verification",
    headline: "Verify the logic before value depends on it.",
    description:
      "Manual review, AI-assisted analysis, adversarial testing, and formal verification focus on the paths that carry real risk.",
    outputs: ["Threat modeling", "Code review", "Formal methods", "Remediation"],
    href: "/security-audit",
    cta: "Explore Security Audit",
    layout: "left",
  },
];

const operatingModel = [
  { title: "Research", description: "Market signal and opportunity map" },
  { title: "Define", description: "Product thesis and launch narrative" },
  { title: "Build", description: "Working product and infrastructure" },
  { title: "Verify", description: "Assurance evidence and remediation" },
  { title: "Launch", description: "KOL, ecosystem, and growth loops" },
];

const studioLeads = [
  { name: "Frederic", role: "Architecture and engineering", href: "/frederic" },
  { name: "Zou", role: "Strategy and product", href: "/zou" },
];

const studioTeam = [
  { name: "KC", role: "Backend infrastructure" },
  { name: "Lun", role: "Creative direction" },
  { name: "Malingshu", role: "Applied AI" },
];

const studioPractices = [
  { title: "Find demand", description: "Market research, positioning, KOL strategy, and ecosystem activation" },
  { title: "Build the system", description: "Product, experience, smart contracts, backend infrastructure, and applied AI" },
  { title: "Verify the logic", description: "Manual review, adversarial testing, and formal methods for critical paths" },
];
---

<main class="home-shell" data-continuum-shell>
  <ScrollContinuum />

  <div class="home-content">
    <section id="home" data-scene-marker="hero" class="hero-section">
      <div class="hero-stage chapter-grid">
        <p class="brand-line">
          Zzyzx Labs <span aria-hidden="true">/</span> Web3 × AI
        </p>

        <h1 class="hero-title">
          <span class="hero-line-mask hero-line-mask--rear">
            <span data-hero-line="back">Demand. Product.</span>
          </span>
          <span class="hero-line-mask hero-line-mask--front">
            <span data-hero-line="front">Proof.</span>
          </span>
        </h1>

        <figure class="hero-object" aria-hidden="true">
          <div class="hero-visual-anchor">
            <img
              src="/zzyzx-proof-instrument-v4.webp"
              alt=""
              width="1586"
              height="992"
              loading="eager"
              fetchpriority="high"
              class="hero-fallback-art"
            />
          </div>
        </figure>

        <span class="hero-scrim" aria-hidden="true"></span>
        <div class="hero-support" data-hero-support>
          <p>One team across market strategy, product engineering, and security for ambitious Web3 and AI teams.</p>
          <div class="hero-actions">
            <a href="mailto:contact@zzyzx.com?subject=Start%20a%20brief" class="button-primary">
              Start a brief
            </a>
            <a href="#solutions" class="text-link">Explore the system <span aria-hidden="true">↘</span></a>
          </div>
        </div>
      </div>
    </section>

    <section data-scene-marker="thesis" class="thesis-section">
      <div class="thesis-stage chapter-grid">
        <span class="thesis-scrim" aria-hidden="true"></span>
        <p class="thesis-copy">
          <span class="thesis-line-mask">
            <span data-thesis-clause>The market thesis shapes the product.</span>
          </span>
          <span class="thesis-line-mask">
            <span data-thesis-clause>The product defines what must be verified.</span>
          </span>
          <span class="thesis-line-mask">
            <span data-thesis-clause>Shared context makes every decision compound.</span>
          </span>
        </p>
      </div>
    </section>

    <section id="solutions" data-scene-marker="capabilities" class="capabilities-story">
      <div class="capability-marker-rail" aria-hidden="true">
        {capabilities.map((_, index) => (
          <span
            class="capability-marker"
            data-capability-marker={index}
            data-scene-marker={`capability-${index}`}
          ></span>
        ))}
      </div>

      <div class="capabilities-stage">
        <div class="capabilities-frame chapter-grid">
          <header class="capabilities-intro">
            <div class="capabilities-intro-copy">
              <p class="section-label">Capabilities</p>
              <h2 class="section-title">One partner across the work that matters.</h2>
              <p class="section-intro">
                Fewer handoffs. Clearer ownership. The people shaping demand stay close to delivery and risk.
              </p>
            </div>
          </header>

          <div class="capability-panels">
            {capabilities.map((capability, index) => (
              <article
                class="capability-panel"
                data-capability-panel={index}
                data-service-layout={capability.layout}
                data-active={index === 0 ? "true" : undefined}
              >
                <span class="capability-scrim" aria-hidden="true"></span>
                <div class="capability-copy" data-capability-copy={index}>
                  <p class="capability-name">{capability.name}</p>
                  <div class="capability-title-mask">
                    <h3>{capability.headline}</h3>
                  </div>
                  <p class="capability-description">{capability.description}</p>
                  <ul class="capability-outputs">
                    {capability.outputs.map((output) => <li>{output}</li>)}
                  </ul>
                  <a href={capability.href} class="text-link">
                    {capability.cta} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="approach" data-scene-marker="approach" class="approach-story continuum-surface">
      <div class="approach-stage chapter-grid">
        <span class="approach-scrim" aria-hidden="true"></span>
        <header class="approach-heading">
          <h2 class="section-title">One continuous route from research to release.</h2>
        </header>

        <ol class="process-steps">
          {operatingModel.map((step, index) => (
            <li class="process-step" data-process-step={index}>
              <div class="process-title-mask"><h3>{step.title}</h3></div>
              <p>{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="work" data-scene-marker="portfolio" class="portfolio-section">
      <div class="portfolio-stage chapter-grid">
        <header class="portfolio-intro">
          <h2 class="section-title">Products built where Web3 and AI become useful.</h2>
          <p class="section-intro">Wallets, payments, AI agents, and onchain infrastructure delivered as working systems.</p>
          <a href="/portfolio" class="text-link">View portfolio <span aria-hidden="true">↗</span></a>
        </header>

        <article class="portfolio-flagship">
          <div class="portfolio-media-wrap">
            <figure class="portfolio-media" data-portfolio-media>
              <img
                src="/nereus-case.webp"
                alt="Nereus prediction market interface"
                width="1737"
                height="933"
                loading="lazy"
              />
            </figure>
            <h3>Nereus</h3>
          </div>

          <div class="portfolio-flagship-copy">
            <p class="case-kind">AI agents and TEE</p>
            <p class="case-description">
              A prediction market using AI agents in trusted execution environments for decentralized outcome resolution.
            </p>
            <dl class="case-facts">
              <div>
                <dt>Scope</dt>
                <dd>Product, AI, Web3</dd>
              </div>
              <div>
                <dt>System</dt>
                <dd>Prediction market</dd>
              </div>
            </dl>
            <a href="https://trynereus.xyz" target="_blank" rel="noreferrer" class="text-link">
              Visit Nereus <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <div class="portfolio-secondary">
          <article class="portfolio-secondary-project portfolio-secondary-project--wide">
            <figure class="portfolio-secondary-media" data-portfolio-media>
              <img
                src="/seawallet-case.webp"
                alt="SeaWallet launch artwork with a pixel ocean and the SeaWallet.ai wordmark"
                width="1456"
                height="816"
                loading="lazy"
              />
            </figure>
            <div class="portfolio-secondary-copy">
              <p class="case-kind">Smart account infrastructure</p>
              <h3>SeaWallet</h3>
              <p>A smart contract account platform for customizable inheritance and asset distribution.</p>
              <a href="https://SeaWallet.ai" target="_blank" rel="noreferrer" class="text-link">
                Visit SeaWallet <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>

          <article class="portfolio-secondary-project portfolio-secondary-project--compact">
            <p class="case-kind">Agent-ready payments</p>
            <h3>SeaPay</h3>
            <p>A hotel payment gateway integrating x402 and A2A standards for AI-led travel booking.</p>
            <a href="https://SeaPay.ai" target="_blank" rel="noreferrer" class="text-link">
              Visit SeaPay <span aria-hidden="true">↗</span>
            </a>
          </article>
        </div>
      </div>
    </section>

    <section id="about" data-scene-marker="studio" class="studio-section continuum-surface">
      <div class="studio-stage chapter-grid">
        <header class="studio-heading" data-studio-reveal>
          <h2 class="section-title">Senior operators, one delivery team.</h2>
          <p class="section-intro">
            Strategy, product, engineering, design, AI, and security stay connected from the first market question to release.
          </p>
        </header>

        <span class="studio-scrim" aria-hidden="true"></span>
        <p class="studio-statement" data-studio-reveal>
          The people shaping demand stay close to the people building and verifying the product.
        </p>

        <div class="studio-practices" data-studio-reveal>
          {studioPractices.map((practice) => (
            <article class="studio-practice">
              <h3>{practice.title}</h3>
              <p>{practice.description}</p>
            </article>
          ))}
        </div>

        <div class="studio-people" data-studio-reveal>
          <div class="studio-leadership">
            <p class="studio-group-label">Leadership</p>
            <div class="studio-leads">
              {studioLeads.map((member) => (
                <a href={member.href} class="studio-person-link">
                  <span class="studio-person-name">{member.name}</span>
                  <span class="studio-person-role">{member.role}</span>
                  <span aria-hidden="true" class="studio-person-arrow">↗</span>
                </a>
              ))}
            </div>
          </div>

          <div class="studio-core">
            <p class="studio-group-label">Core team</p>
            <div class="studio-core-team">
              {studioTeam.map((member) => (
                <div class="studio-core-member">
                  <span class="studio-person-name">{member.name}</span>
                  <span class="studio-person-role">{member.role}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section data-scene-marker="cta" class="cta-section">
      <div class="cta-stage chapter-grid">
        <span class="cta-scrim" aria-hidden="true"></span>
        <h2 class="cta-title">
          <span class="cta-line-mask"><span data-cta-line>Tell us what you are building.</span></span>
          <span class="cta-line-mask"><span data-cta-line>We will find the cleanest route to release.</span></span>
        </h2>
        <a href="mailto:contact@zzyzx.com?subject=Start%20a%20brief" class="button-primary cta-button">
          Start a brief
        </a>
      </div>
    </section>
  </div>
</main>

<script>
  declare global {
    interface Window {
      __zzyzxCapabilityTableauCleanup?: () => void;
      __zzyzxCapabilityTableauPageLoad?: EventListener;
    }
  }

  if (window.__zzyzxCapabilityTableauPageLoad) {
    document.removeEventListener("astro:page-load", window.__zzyzxCapabilityTableauPageLoad);
  }
  window.__zzyzxCapabilityTableauCleanup?.();

  const mountCapabilityTableau = () => {
    window.__zzyzxCapabilityTableauCleanup?.();

    const shell = document.querySelector<HTMLElement>("[data-continuum-shell]");
    const markers = Array.from(document.querySelectorAll<HTMLElement>("[data-capability-marker]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-capability-panel]"));
    if (!shell || markers.length === 0 || panels.length === 0) return;

    const desktopTableau = window.matchMedia("(min-width: 1024px) and (min-height: 700px) and (pointer: fine)");
    let activeIndex = 0;

    const syncAccessibility = () => {
      const tableauIsActive = desktopTableau.matches
        && ["ready", "failed-active"].includes(shell.dataset.continuumStatus ?? "");
      panels.forEach((panel, index) => {
        const hidden = tableauIsActive && index !== activeIndex;
        panel.toggleAttribute("inert", hidden);
        if (hidden) panel.setAttribute("aria-hidden", "true");
        else panel.removeAttribute("aria-hidden");
      });
    };

    const setActive = (index: number) => {
      const nextIndex = Math.max(0, Math.min(panels.length - 1, index));
      const activeElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      const focusNeedsHandoff = nextIndex !== activeIndex
        && Boolean(activeElement && panels[activeIndex]?.contains(activeElement));

      activeIndex = nextIndex;
      panels.forEach((panel, panelIndex) => {
        if (panelIndex === activeIndex) panel.dataset.active = "true";
        else delete panel.dataset.active;
      });

      if (focusNeedsHandoff) {
        const nextPanel = panels[activeIndex];
        nextPanel?.removeAttribute("inert");
        nextPanel?.removeAttribute("aria-hidden");
        nextPanel?.querySelector<HTMLElement>("a[href], button:not([disabled]), [tabindex]:not([tabindex='-1'])")
          ?.focus({ preventScroll: true });
      }

      shell.dataset.capabilityScene = String(activeIndex);
      syncAccessibility();
    };

    const chooseClosestMarker = () => {
      const viewportCenter = window.innerHeight * 0.5;
      const closest = markers.reduce(
        (best, marker, index) => {
          const rect = marker.getBoundingClientRect();
          const distance = rect.top <= viewportCenter && rect.bottom >= viewportCenter
            ? 0
            : Math.min(Math.abs(rect.top - viewportCenter), Math.abs(rect.bottom - viewportCenter));
          return distance < best.distance ? { index, distance } : best;
        },
        { index: activeIndex, distance: Number.POSITIVE_INFINITY },
      );
      setActive(closest.index);
    };

    const observer = new IntersectionObserver(chooseClosestMarker, {
      rootMargin: "-46% 0px -46% 0px",
      threshold: 0,
    });
    markers.forEach((marker) => observer.observe(marker));

    const statusObserver = new MutationObserver(syncAccessibility);
    statusObserver.observe(shell, { attributes: true, attributeFilter: ["data-continuum-status"] });
    desktopTableau.addEventListener("change", syncAccessibility);
    chooseClosestMarker();

    window.__zzyzxCapabilityTableauCleanup = () => {
      observer.disconnect();
      statusObserver.disconnect();
      desktopTableau.removeEventListener("change", syncAccessibility);
      panels.forEach((panel) => {
        panel.removeAttribute("inert");
        panel.removeAttribute("aria-hidden");
      });
      delete shell.dataset.capabilityScene;
    };
  };

  const handleCapabilityPageLoad = () => mountCapabilityTableau();
  window.__zzyzxCapabilityTableauPageLoad = handleCapabilityPageLoad;
  document.addEventListener("astro:page-load", handleCapabilityPageLoad);
  mountCapabilityTableau();

  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      document.removeEventListener("astro:page-load", handleCapabilityPageLoad);
      window.__zzyzxCapabilityTableauCleanup?.();
      delete window.__zzyzxCapabilityTableauPageLoad;
    });
  }
</script>

<style>
  .home-shell {
    --page-gutter: clamp(1.25rem, 3vw, 2.5rem);
    --content-max: 90rem;
    --ink: #f2f3ef;
    --ink-soft: #d7dbd8;
    --smoke: #899198;
    --smoke-deep: #626b72;
    --line: rgba(255, 255, 255, 0.11);
    --cyan: #74d7dd;
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    background: #08090a;
    color: var(--ink);
    font-family: var(--font-heading);
  }

  .home-content,
  .home-content > section {
    position: relative;
  }

  .chapter-grid {
    display: grid;
    width: min(calc(100% - var(--page-gutter) * 2), var(--content-max));
    margin-inline: auto;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
  }

  .continuum-surface {
    background: rgba(13, 15, 17, 0.34);
  }

  .brand-line,
  .section-label {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .brand-line {
    z-index: 4;
    grid-column: 1 / 6;
    align-self: end;
    color: #949ba1;
  }

  .brand-line span,
  .section-label {
    color: var(--cyan);
  }

  .section-label {
    margin-bottom: 1.25rem;
  }

  .section-title {
    max-width: 18ch;
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 4.5vw, 4.8rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.052em;
    color: #eef0ed;
  }

  .section-intro {
    max-width: 37rem;
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    line-height: 1.65;
    color: var(--smoke);
  }

  .hero-section {
    min-height: 100dvh;
    padding-top: 4.25rem;
    background:
      linear-gradient(90deg, rgba(8, 9, 10, 0.62), transparent 38%),
      radial-gradient(ellipse at 72% 42%, rgba(116, 215, 221, 0.035), transparent 36rem);
  }

  .hero-stage {
    min-height: calc(100dvh - 4.25rem);
    padding-block: clamp(1.75rem, 4.5vh, 3.75rem);
    grid-template-rows: auto minmax(0, 1fr) auto;
    align-items: start;
    row-gap: clamp(1.5rem, 3vh, 2.5rem);
  }

  .hero-title {
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: inherit;
    align-self: center;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(3.2rem, 7.65vw, 8.6rem);
    font-weight: 450;
    line-height: 0.88;
    letter-spacing: -0.052em;
    color: var(--ink);
  }

  .hero-line-mask {
    position: relative;
    display: block;
    overflow: clip;
    padding-block: 0.05em 0.1em;
  }

  .hero-line-mask--rear {
    z-index: 1;
    grid-column: 1 / 12;
  }

  .hero-line-mask--front {
    z-index: 4;
    grid-column: 3 / 13;
    justify-self: end;
  }

  [data-hero-line] {
    position: relative;
    display: block;
    white-space: nowrap;
  }

  [data-hero-line="back"] {
    color: rgba(221, 226, 224, 0.1);
    -webkit-text-stroke: 1px rgba(223, 230, 228, 0.42);
  }

  [data-hero-line="front"] {
    color: #e8ebe8;
  }

  .hero-object {
    position: absolute;
    z-index: 2;
    top: 3%;
    right: max(calc(var(--page-gutter) * -0.4), calc((100vw - var(--content-max)) / 2 - 5rem));
    width: min(68vw, 67rem);
    height: 91%;
    margin: 0;
    pointer-events: none;
  }

  .hero-visual-anchor,
  .hero-fallback-art {
    width: 100%;
    height: 100%;
  }

  .hero-fallback-art {
    display: block;
    object-fit: cover;
    object-position: 52% center;
    opacity: 0.94;
    mask-image: linear-gradient(90deg, transparent 0%, #000 12%, #000 89%, transparent 100%);
    transition: opacity 500ms ease, visibility 500ms ease;
  }

  .home-shell[data-continuum-status="ready"] .hero-fallback-art {
    visibility: hidden;
    opacity: 0;
  }

  .hero-scrim,
  .thesis-scrim,
  .capability-scrim,
  .approach-scrim,
  .studio-scrim,
  .cta-scrim {
    position: absolute;
    z-index: 3;
    pointer-events: none;
  }

  .hero-scrim {
    left: calc((100vw - min(calc(100vw - var(--page-gutter) * 2), var(--content-max))) / 2 - 2rem);
    bottom: 0;
    width: min(42rem, 56vw);
    height: 17rem;
    background: linear-gradient(90deg, rgba(8, 9, 10, 0.96), rgba(8, 9, 10, 0.68) 58%, transparent);
  }

  .hero-support {
    position: relative;
    z-index: 4;
    grid-row: 3;
    grid-column: 1 / 6;
    max-width: 34rem;
  }

  .hero-support > p {
    font-size: clamp(1rem, 0.92rem + 0.35vw, 1.2rem);
    line-height: 1.6;
    color: #a0a7ac;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-top: 2rem;
  }

  .button-primary {
    display: inline-flex;
    min-height: 3.35rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--cyan);
    border-radius: 2px;
    padding: 0.85rem 1.45rem;
    background: var(--cyan);
    color: #071012;
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 220ms ease, border-color 220ms ease, transform 220ms ease;
  }

  .button-primary:hover {
    border-color: #a3e6e9;
    background: #a3e6e9;
    transform: translateY(-1px);
  }

  .button-primary:active {
    transform: translateY(1px);
  }

  .text-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.7rem;
    border-bottom: 1px solid rgba(116, 215, 221, 0.4);
    padding-bottom: 0.2rem;
    color: #a4e3e7;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 220ms ease, color 220ms ease;
  }

  .text-link:hover {
    border-color: #d0f3f4;
    color: #d0f3f4;
  }

  .button-primary:focus-visible,
  .text-link:focus-visible,
  .studio-person-link:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 4px;
  }

  .thesis-section {
    min-height: 76dvh;
  }

  .thesis-stage {
    min-height: 76dvh;
    align-items: center;
  }

  .thesis-scrim {
    inset: 8% 42% 8% -10%;
    background: linear-gradient(90deg, rgba(8, 9, 10, 0.96), rgba(8, 9, 10, 0.5) 72%, transparent);
  }

  .thesis-copy {
    position: relative;
    z-index: 4;
    grid-column: 1 / 12;
    font-family: var(--font-heading);
    font-size: clamp(2.3rem, 4.25vw, 4.7rem);
    font-weight: 430;
    line-height: 1.03;
    letter-spacing: -0.042em;
  }

  .thesis-line-mask {
    display: block;
    overflow: clip;
    width: fit-content;
