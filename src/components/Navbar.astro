---
import BrandMark from "./BrandMark.astro";
import { serviceNavItems } from "../data/services";

const pathname = Astro.url.pathname;
const isCurrentPath = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const isServiceActive = serviceNavItems.some((service) => isCurrentPath(service.href));
const isPortfolioActive = isCurrentPath("/portfolio");
---

<nav id="main-navbar" class="fixed inset-x-0 top-0 z-[100] border-b border-[var(--shell-line)] bg-[var(--shell-bg-alpha)] backdrop-blur-[2px]">
  <div class="mx-auto flex h-[4.25rem] max-w-[88rem] items-center justify-between px-5 sm:px-7 lg:px-10">
    <a href="/" class="brand-link group inline-flex items-center gap-3" aria-label="Zzyzx Labs home">
      <BrandMark class="h-7 w-7 text-[var(--shell-ink)] opacity-90 transition-opacity duration-200 group-hover:opacity-100" />
      <span class="font-heading text-[1.05rem] font-medium tracking-[-0.025em] text-[var(--shell-ink)]">Zzyzx Labs</span>
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      <div id="desktop-services" class="services-wrap relative">
        <button
          id="services-trigger"
          type="button"
          class:list={["nav-link", "services-trigger", isServiceActive && "nav-link-active"]}
          aria-expanded="false"
          aria-controls="services-dropdown"
        >
          <span>Services</span>
          <span class="services-caret" aria-hidden="true"></span>
        </button>

        <div id="services-dropdown" class="services-dropdown" aria-label="Services" hidden>
          <div class="services-dropdown-panel">
            <ul>
              {serviceNavItems.map((service) => (
                <li>
                  <a
                    href={service.href}
                    aria-current={isCurrentPath(service.href) ? "page" : undefined}
                    class:list={["service-option", isCurrentPath(service.href) && "service-option-active"]}
                  >
                    <span class="service-option-name">{service.name}</span>
                    <span class="service-option-description">{service.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <a
        href="/portfolio"
        aria-current={isPortfolioActive ? "page" : undefined}
        class:list={["nav-link", isPortfolioActive && "nav-link-active"]}
      >Portfolio</a>
      <a href="mailto:contact@zzyzx.com?subject=Start%20a%20brief" class="nav-cta">Start a brief</a>
    </div>

    <button
      id="nav-toggle"
      class="nav-toggle inline-flex h-10 w-10 items-center justify-center lg:hidden"
      aria-label="Open navigation"
      aria-controls="mobile-menu"
      aria-expanded="false"
      type="button"
    >
      <span class="sr-only">Menu</span>
      <span class="menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-[var(--shell-line)] bg-[var(--shell-bg)] lg:hidden">
    <div class="mobile-menu-inner mx-auto flex max-w-[88rem] flex-col px-5 sm:px-7">
      <button
        id="mobile-services-toggle"
        type="button"
        class:list={["mobile-nav-link", "mobile-services-toggle", isServiceActive && "mobile-nav-link-active"]}
        aria-expanded="false"
        aria-controls="mobile-services-list"
      >
        <span>Services</span>
        <span class="services-caret" aria-hidden="true"></span>
      </button>
      <ul id="mobile-services-list" class="mobile-services-list" hidden>
        {serviceNavItems.map((service) => (
          <li>
            <a
              href={service.href}
              aria-current={isCurrentPath(service.href) ? "page" : undefined}
              class:list={["mobile-service-option", isCurrentPath(service.href) && "mobile-service-option-active"]}
            >
              <span>{service.name}</span>
              <span>{service.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/portfolio"
        aria-current={isPortfolioActive ? "page" : undefined}
        class:list={["mobile-nav-link", isPortfolioActive && "mobile-nav-link-active"]}
      >Portfolio</a>
      <a href="mailto:contact@zzyzx.com?subject=Start%20a%20brief" class="nav-cta mobile-contact-link mt-5 w-full justify-center">Start a brief</a>
    </div>
  </div>
</nav>

<script>
  const navToggle = document.getElementById("nav-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const servicesWrap = document.getElementById("desktop-services");
  const servicesTrigger = document.getElementById("services-trigger");
  const servicesDropdown = document.getElementById("services-dropdown");
  const mobileServicesToggle = document.getElementById("mobile-services-toggle");
  const mobileServicesList = document.getElementById("mobile-services-list");
  const navRoot = document.getElementById("main-navbar");
  const pageRegions = [document.querySelector("main"), document.querySelector("footer")].filter(
    (region) => region instanceof HTMLElement,
  );
  const desktopMedia = window.matchMedia("(min-width: 1024px)");
  const hoverMedia = window.matchMedia("(min-width: 1024px) and (hover: hover) and (pointer: fine)");
  const desktopServiceLinks = Array.from(servicesDropdown?.querySelectorAll("a") ?? []);
  const regionInertState = new Map();
  let closeDelay;
  let openedByHover = false;
  let pageOverflow = "";

  function openDesktopServices(focusIndex, fromHover = false) {
    if (!desktopMedia.matches) return;
    window.clearTimeout(closeDelay);
    if (servicesDropdown) servicesDropdown.hidden = false;
    servicesTrigger?.setAttribute("aria-expanded", "true");
    openedByHover = fromHover;
    if (typeof focusIndex === "number") desktopServiceLinks[focusIndex]?.focus();
  }

  function closeDesktopServices(restoreFocus = false) {
    window.clearTimeout(closeDelay);
    if (servicesDropdown) servicesDropdown.hidden = true;
    servicesTrigger?.setAttribute("aria-expanded", "false");
    openedByHover = false;
    if (restoreFocus) servicesTrigger?.focus();
  }

  function scheduleDesktopClose() {
    if (!hoverMedia.matches) return;
    window.clearTimeout(closeDelay);
    closeDelay = window.setTimeout(() => {
      if (!servicesWrap?.contains(document.activeElement)) closeDesktopServices();
    }, 140);
  }

  function collapseMobileServices() {
    if (mobileServicesList) mobileServicesList.hidden = true;
    mobileServicesToggle?.setAttribute("aria-expanded", "false");
  }

  function setPageInert(inert) {
    if (!inert && regionInertState.size === 0) return;
    pageRegions.forEach((region) => {
      if (inert) {
        regionInertState.set(region, region.hasAttribute("inert"));
        region.setAttribute("inert", "");
      } else if (!regionInertState.get(region)) {
        region.removeAttribute("inert");
      }
    });
    if (inert) {
      pageOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = "hidden";
    } else {
      document.documentElement.style.overflow = pageOverflow;
      regionInertState.clear();
    }
  }

  function openMobileMenu() {
    mobileMenu?.classList.remove("hidden");
    navToggle?.setAttribute("aria-expanded", "true");
    navToggle?.setAttribute("aria-label", "Close navigation");
    setPageInert(true);
    window.requestAnimationFrame(() => mobileServicesToggle?.focus());
  }

  function closeMobileMenu(restoreFocus = false) {
    mobileMenu?.classList.add("hidden");
    navToggle?.setAttribute("aria-expanded", "false");
    navToggle?.setAttribute("aria-label", "Open navigation");
    collapseMobileServices();
    setPageInert(false);
    if (restoreFocus) navToggle?.focus();
  }

  servicesTrigger?.addEventListener("click", (event) => {
    if (event.detail > 0 && openedByHover && servicesDropdown && !servicesDropdown.hidden) {
      openedByHover = false;
      return;
    }
    if (servicesDropdown?.hidden) openDesktopServices();
    else closeDesktopServices();
  });

  servicesTrigger?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown") {
      event.preventDefault();
      openDesktopServices(0);
    }
    if (event.key === "ArrowUp") {
      event.preventDefault();
      openDesktopServices(desktopServiceLinks.length - 1);
    }
    if (event.key === "Escape") closeDesktopServices(true);
  });

  servicesWrap?.addEventListener("pointerenter", () => {
    if (hoverMedia.matches) openDesktopServices(undefined, true);
  });
  servicesWrap?.addEventListener("pointerleave", scheduleDesktopClose);
  servicesDropdown?.addEventListener("pointerenter", () => window.clearTimeout(closeDelay));
  servicesDropdown?.addEventListener("pointerleave", scheduleDesktopClose);

  servicesDropdown?.addEventListener("keydown", (event) => {
    const currentIndex = desktopServiceLinks.indexOf(document.activeElement);
    if (event.key === "Escape") {
      event.preventDefault();
      closeDesktopServices(true);
    }
    if (event.key === "ArrowDown") {
      event.preventDefault();
      desktopServiceLinks[(currentIndex + 1) % desktopServiceLinks.length]?.focus();
    }
    if (event.key === "ArrowUp") {
      event.preventDefault();
      desktopServiceLinks[(currentIndex - 1 + desktopServiceLinks.length) % desktopServiceLinks.length]?.focus();
    }
    if (event.key === "Home") {
      event.preventDefault();
      desktopServiceLinks[0]?.focus();
    }
    if (event.key === "End") {
      event.preventDefault();
      desktopServiceLinks[desktopServiceLinks.length - 1]?.focus();
    }
  });

  servicesWrap?.addEventListener("focusout", () => {
    window.setTimeout(() => {
      if (!servicesWrap.contains(document.activeElement)) closeDesktopServices();
    }, 0);
  });

  navToggle?.addEventListener("click", () => {
    const willOpen = mobileMenu?.classList.contains("hidden") ?? false;
    if (willOpen) openMobileMenu();
    else closeMobileMenu(true);
  });

  mobileServicesToggle?.addEventListener("click", () => {
    const willOpen = mobileServicesList?.hidden ?? false;
    if (mobileServicesList) mobileServicesList.hidden = !willOpen;
    mobileServicesToggle.setAttribute("aria-expanded", String(willOpen));
  });

  mobileServicesToggle?.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowDown") return;
    event.preventDefault();
    if (mobileServicesList) mobileServicesList.hidden = false;
    mobileServicesToggle.setAttribute("aria-expanded", "true");
    mobileServicesList?.querySelector("a")?.focus();
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => closeMobileMenu()));

  document.addEventListener("pointerdown", (event) => {
    if (!servicesWrap?.contains(event.target)) closeDesktopServices();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Tab" && navToggle?.getAttribute("aria-expanded") === "true") {
      const focusable = Array.from(
        navRoot?.querySelectorAll("a[href], button:not([disabled]), [tabindex]:not([tabindex='-1'])") ?? [],
      ).filter((element) => element instanceof HTMLElement && element.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      } else if (!focusable.includes(document.activeElement)) {
        event.preventDefault();
        first?.focus();
      }
      return;
    }
    if (event.key !== "Escape") return;
    if (servicesTrigger?.getAttribute("aria-expanded") === "true") {
      closeDesktopServices(true);
      return;
    }
    if (mobileServicesToggle?.getAttribute("aria-expanded") === "true") {
      collapseMobileServices();
      mobileServicesToggle.focus();
      return;
    }
    if (navToggle?.getAttribute("aria-expanded") === "true") {
      closeMobileMenu(true);
    }
  });

  desktopMedia.addEventListener("change", () => {
    closeDesktopServices();
    closeMobileMenu(false);
  });
</script>

<style>
  .brand-link,
  .nav-link,
  .mobile-nav-link,
  .nav-cta,
  .service-option,
  .mobile-service-option {
    text-decoration: none;
  }

  .services-dropdown[hidden],
  .mobile-services-list[hidden] {
    display: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border: 0;
    background: transparent;
    padding-block: 0.45rem;
    font-family: inherit;
    font-size: 0.79rem;
    font-weight: 500;
    letter-spacing: 0.025em;
    color: var(--shell-ink-3);
    cursor: pointer;
    transition: color 200ms ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--shell-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 240ms ease;
  }

  .nav-link:hover,
  .nav-link-active {
    color: var(--shell-ink);
  }

  .nav-link:hover::after,
  .nav-link-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .services-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .services-caret {
    display: block;
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-0.12rem) rotate(45deg);
    transition: transform 200ms ease;
  }

  [aria-expanded="true"] > .services-caret {
    transform: translateY(0.12rem) rotate(225deg);
  }

  .services-dropdown {
    position: fixed;
    top: 4.25rem;
    left: 0;
    width: 100vw;
  }

  .services-dropdown-panel {
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    background: rgba(8, 9, 10, 0.975);
  }

  .services-dropdown-panel ul {
    display: grid;
    width: min(calc(100% - 5rem), 83rem);
    margin: 0 auto;
    padding: 0;
    grid-template-columns: 4fr 5fr 3fr;
    list-style: none;
  }

  .services-dropdown-panel li {
    min-width: 0;
    border-left: 1px solid var(--shell-line);
  }

  .services-dropdown-panel li:first-child {
    border-left: 0;
  }

  .service-option {
    display: grid;
    min-height: 9rem;
    align-content: center;
    gap: 1rem;
    padding: 1.5rem clamp(1.75rem, 3vw, 3.4rem);
    transition: background-color 220ms ease;
  }

  .services-dropdown-panel li:first-child .service-option {
    padding-left: 0;
  }

  .services-dropdown-panel li:last-child .service-option {
    padding-right: 0;
  }

  .service-option:hover,
  .service-option:focus-visible,
  .service-option-active {
    background: rgba(255, 255, 255, 0.018);
  }

  .service-option-name {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 1.9vw, 1.9rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--shell-ink);
    transition: color 220ms ease;
  }

  .service-option-active .service-option-name {
    color: var(--shell-accent-ink);
  }

  .service-option:hover .service-option-name,
  .service-option:focus-visible .service-option-name {
    color: var(--shell-ink);
  }

  .service-option-description {
    max-width: 31ch;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--shell-ink-3);
  }

  .nav-cta {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border: 0;
    padding-block: 0.45rem;
    font-size: 0.81rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--shell-ink);
    transition: color 220ms ease;
  }

  .nav-cta::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--shell-accent);
    transform: scaleX(0.28);
    transform-origin: left center;
    transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-cta:hover {
    color: var(--shell-ink);
  }

  .nav-cta:hover::after,
  .nav-cta:focus-visible::after {
    transform: scaleX(1);
  }

  .mobile-nav-link {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--shell-line);
    background: transparent;
    padding-block: 1.15rem;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 7vw, 2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    text-align: left;
    color: var(--shell-ink-2);
  }

  .mobile-services-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link-active {
    color: var(--shell-accent-ink);
  }

  .mobile-services-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--shell-line);
    background: transparent;
  }

  .mobile-service-option {
    display: grid;
    gap: 0.65rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.065);
    padding: 1.15rem 0;
  }

  .mobile-services-list li:last-child .mobile-service-option {
    border-bottom: 0;
  }

  .mobile-service-option span:first-child {
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 7vw, 2.6rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--shell-ink);
  }

  .mobile-service-option span:last-child {
    max-width: 35ch;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--shell-ink-3);
  }

  .mobile-service-option-active span:first-child {
    color: var(--shell-accent-ink);
  }

  .nav-toggle {
    border-radius: 2px;
    color: var(--shell-ink-2);
  }

  #mobile-menu {
    height: calc(100dvh - 4.25rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu-inner {
    min-height: 100%;
    padding-block: clamp(1.5rem, 4vh, 2.75rem) 2rem;
  }

  .mobile-contact-link {
    margin-top: auto;
    padding-block: 1.1rem 0.7rem;
    font-family: var(--font-heading);
    font-size: 1.05rem;
  }

  .mobile-contact-link::after {
    left: 50%;
    transform: translateX(-50%);
  }

  .menu-icon {
    position: relative;
    display: block;
    width: 1.25rem;
    height: 0.75rem;
  }

  .menu-icon span {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: top 220ms ease, transform 220ms ease;
  }

  .menu-icon span:first-child { top: 0.15rem; }
  .menu-icon span:last-child { top: 0.6rem; }

  .nav-toggle[aria-expanded="true"] .menu-icon span:first-child {
    top: 0.38rem;
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .menu-icon span:last-child {
    top: 0.38rem;
    transform: rotate(-45deg);
  }

  .brand-link:focus-visible,
  .nav-link:focus-visible,
  .mobile-nav-link:focus-visible,
  .nav-cta:focus-visible,
  .nav-toggle:focus-visible,
  .service-option:focus-visible,
  .mobile-service-option:focus-visible {
    outline: 2px solid var(--shell-accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after,
    .nav-cta::after,
    .services-caret,
    .menu-icon span {
      transition: none;
    }
  }
</style>
