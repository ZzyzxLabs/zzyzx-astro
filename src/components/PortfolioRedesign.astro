<script is:inline>
  const portfolioRoot = document.querySelector("[data-portfolio-root]");
  const caseDialog = portfolioRoot?.querySelector("[data-case-dialog]");
  const casePanels = Array.from(portfolioRoot?.querySelectorAll("[data-case-panel]") ?? []);
  const caseTriggers = Array.from(portfolioRoot?.querySelectorAll("[data-case-open]") ?? []);
  const closeButton = portfolioRoot?.querySelector("[data-case-close]");
  let activeTrigger = null;

  const closeCaseDialog = () => {
    if (caseDialog?.open) caseDialog.close();
  };

  caseTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      if (!caseDialog) return;
      const caseId = trigger.dataset.caseOpen;
      const activePanel = casePanels.find((panel) => panel.dataset.casePanel === caseId);
      if (!activePanel || !caseId) return;

      casePanels.forEach((panel) => {
        panel.hidden = panel !== activePanel;
      });

      activeTrigger = trigger;
      caseDialog.setAttribute("aria-labelledby", `case-title-${caseId}`);
      caseDialog.setAttribute("aria-describedby", `case-intro-${caseId}`);
      document.documentElement.dataset.caseOpen = "true";
      caseDialog.showModal();
      closeButton?.focus();
    });
  });

  closeButton?.addEventListener("click", closeCaseDialog);

  caseDialog?.addEventListener("click", (event) => {
    if (event.target === caseDialog) closeCaseDialog();
  });

  caseDialog?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      event.preventDefault();
      closeCaseDialog();
    }
  });

  caseDialog?.addEventListener("close", () => {
    delete document.documentElement.dataset.caseOpen;
    activeTrigger?.focus();
    activeTrigger = null;
  });
</script>

