---
import WriteupRow from "./WriteupRow.astro";
import type { AuditRecord } from "../../data/audits";
import "../../styles/audit-writeup.css";

interface Props {
  label: string;
  heading: string;
  empty: string;
  /** Picks the lane colour: incidents take the risk signal, our own reports take ink. */
  tone: "incident" | "report";
  records: AuditRecord[];
}

const { label, heading, empty, tone, records } = Astro.props;
---

<main class="index-shell" style={`--lane: var(--lane-${tone});`}>
  <div class="index-frame">
    <nav class="index-crumbs" aria-label="Breadcrumb">
      <a href="/security-audit">Security Audit</a>
      <span aria-hidden="true">/</span>
      <span>{label}</span>
    </nav>

    <header class="index-head">
      <div>
        <h1 class="index-title">{heading}</h1>
      </div>
      <p class="index-count">{records.length} {records.length === 1 ? "writeup" : "writeups"}</p>
    </header>

    {records.length > 0 ? (
      <div class="index-grid" data-animate-group>
        {records.map((record) => <WriteupRow record={record} headingLevel={2} />)}
      </div>
    ) : (
      <p class="index-empty">{empty}</p>
    )}

    <footer class="index-foot">
      <a class="index-back" href="/security-audit">Back to Security Audit</a>
      <a class="index-cta" href="mailto:contact@zzyzx.com?subject=Security%20Audit%20Inquiry">Request an audit</a>
    </footer>
  </div>
</main>

<style>
  .index-shell {
    position: relative;
    padding: 6rem 1.25rem 0;
    background: var(--audit-ground);
    color: var(--audit-ink);
  }

  /* A raised header plane fading into the ground: the page has a top instead of
   * being one uninterrupted black field. The lane wash names which archive
   * you are in before you read the label. */
  .index-shell::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 30rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--lane) 8%, transparent), transparent 55%),
      linear-gradient(180deg, var(--audit-ground-2), transparent);
    pointer-events: none;
  }

  .index-frame {
    position: relative;
    max-width: 88rem;
    margin-inline: auto;
    padding-bottom: 7rem;
  }

  .index-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--audit-ink-4);
  }

  .index-crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    color: var(--audit-ink-3);
    text-decoration: none;
  }

  .index-crumbs a:hover {
    color: var(--audit-signal);
  }

  .index-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 4rem;
    margin-top: 2.5rem;
    padding-bottom: 3rem;
  }

  .index-title {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.1rem, 3.6vw, 3.1rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: var(--audit-ink);
    text-wrap: balance;
  }


  .index-count {
    margin: 0;
    font-size: 0.78rem;
    color: var(--audit-ink-4);
    font-variant-numeric: tabular-nums;
  }

  .index-grid {
    display: grid;
    border-top: 1px solid var(--audit-line-strong);
    gap: 0 3.5rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .index-empty {
    max-width: 34rem;
    border-top: 1px solid var(--audit-line-strong);
    padding-top: 1.75rem;
    line-height: 1.75;
    color: var(--audit-ink-3);
  }

  .index-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 4rem;
    border-top: 1px solid var(--audit-line);
    padding-top: 2rem;
  }

  .index-back {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    border-bottom: 1px solid var(--audit-line-strong);
    padding-bottom: 0.2rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--audit-ink);
    text-decoration: none;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .index-back:hover {
    border-bottom-color: var(--audit-signal);
    color: var(--audit-signal);
  }

  .index-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    padding: 0.8rem 1.35rem;
    background: var(--audit-signal);
    color: var(--audit-on-signal);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 220ms ease;
  }

  .index-cta:hover {
    background: var(--audit-ink);
  }

  .index-back:focus-visible,
  .index-cta:focus-visible {
    outline: 2px solid var(--audit-ink);
    outline-offset: 4px;
  }

  @media (min-width: 900px) {
    .index-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .index-shell {
      padding-top: 4.75rem;
    }

    .index-cta {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index-cta {
      transition: none;
    }
  }
</style>
