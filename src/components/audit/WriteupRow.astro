---
import { SEVERITIES } from "../../content.config";
import { severityLabels } from "../../lib/findings";
import { formatAuditDate, type AuditRecord } from "../../data/audits";

interface Props {
  record: AuditRecord;
  /** 4 under an archive lane heading, 2 directly under an index page's h1. */
  headingLevel?: 2 | 3 | 4;
}

const { record, headingLevel = 4 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3" | "h4";
const { data } = record.entry;
const scored = SEVERITIES.filter((severity) => record.counts[severity] > 0);
/** SEVERITIES is ordered worst-first, so the first hit is the row's headline risk. */
const topSeverity = scored[0];
---

<article class="writeup-row" data-animate-item="fade-up" data-top-severity={topSeverity}>
  <a class="writeup-row__link" href={record.href}>
    <div class="writeup-row__top">
      <span class="writeup-row__project">{data.project}</span>
      <span class="writeup-row__date">{formatAuditDate(data.publishedAt)}</span>
    </div>
    <Heading class="writeup-row__title">{data.title}</Heading>
  </a>
  <div class="writeup-row__foot">
    <span class="writeup-row__ecosystem">{data.ecosystem}</span>
    {scored.length > 0 && (
      <span class="writeup-row__counts">
        {scored.map((severity, index) => (
          <span class="writeup-row__count" data-severity={severity} data-lead={index === 0 ? "true" : undefined}>
            <b>{record.counts[severity]}</b> {severityLabels[severity].toLowerCase()}
          </span>
        ))}
      </span>
    )}
    {data.draft && <span class="writeup-row__draft">Draft</span>}
  </div>
</article>

<style>
  /* The rule above each row carries its worst finding, so the archive reads as a
   * severity spectrum before any title is parsed. --lane is set by the column. */
  .writeup-row {
    --row-tone: var(--lane, var(--audit-signal));
    position: relative;
    border-top: 1px solid var(--audit-line-soft);
    padding: 1.35rem 0 1.5rem;
  }

  .writeup-row[data-top-severity] {
    border-top: 1px solid color-mix(in srgb, var(--row-tone) 42%, transparent);
  }

  .writeup-row[data-top-severity="critical"] { --row-tone: var(--sev-critical); }
  .writeup-row[data-top-severity="high"] { --row-tone: var(--sev-high); }
  .writeup-row[data-top-severity="medium"] { --row-tone: var(--sev-medium); }
  .writeup-row[data-top-severity="low"] { --row-tone: var(--sev-low); }
  .writeup-row[data-top-severity="informational"] { --row-tone: var(--sev-info); }

  /* Hover lifts the row onto the raised plane instead of only recolouring text. */
  .writeup-row::before {
    content: "";
    position: absolute;
    inset: 1px -1.1rem 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--row-tone) 9%, transparent), transparent 60%),
      var(--audit-ground-2);
    opacity: 0;
    transition: opacity 220ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .writeup-row:hover::before,
  .writeup-row:focus-within::before {
    opacity: 1;
  }

  .writeup-row__link,
  .writeup-row__foot {
    position: relative;
  }

  .writeup-row__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .writeup-row__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.78rem;
    color: var(--audit-ink-4);
  }

  .writeup-row__project {
    color: var(--audit-ink-3);
  }

  .writeup-row__title {
    margin: 0.55rem 0 0;
    max-width: 38ch;
    font-family: var(--font-reading);
    font-size: 1.22rem;
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -0.012em;
    color: var(--audit-ink);
    text-wrap: balance;
    transition: color 200ms ease;
  }

  .writeup-row__link:hover .writeup-row__title {
    color: var(--audit-signal);
  }

  .writeup-row__link:focus-visible {
    outline: 2px solid var(--audit-signal);
    outline-offset: 4px;
  }

  .writeup-row__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin-top: 0.95rem;
  }

  .writeup-row__ecosystem {
    font-size: 0.76rem;
    color: var(--audit-ink-4);
  }

  /* A tally, not a badge rack. Boxing every severity made each row equally loud,
   * so the row that topped out at medium looked the same as the one carrying a
   * high. Only the worst severity gets the swatch; the rest is a plain count. */
  .writeup-row__counts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.85rem;
    font-size: 0.74rem;
    color: var(--audit-ink-4);
  }

  .writeup-row__count {
    --count-tone: var(--audit-ink-4);
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .writeup-row__count b {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--audit-ink-3);
  }

  .writeup-row__count[data-lead] {
    position: relative;
    padding-left: 0.75rem;
    color: var(--count-tone);
  }

  .writeup-row__count[data-lead] b {
    font-weight: 600;
    color: var(--count-tone);
  }

  .writeup-row__count[data-lead]::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 1px;
    background: var(--count-tone);
  }

  .writeup-row__count[data-severity="critical"] { --count-tone: var(--sev-critical); }
  .writeup-row__count[data-severity="high"] { --count-tone: var(--sev-high); }
  .writeup-row__count[data-severity="medium"] { --count-tone: var(--sev-medium); }
  .writeup-row__count[data-severity="low"] { --count-tone: var(--sev-low); }
  .writeup-row__count[data-severity="informational"] { --count-tone: var(--sev-info); }

  .writeup-row__draft {
    border: 1px dashed color-mix(in srgb, var(--sev-medium) 55%, transparent);
    padding: 0.1rem 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--sev-medium);
  }

  @media (prefers-reduced-motion: reduce) {
    .writeup-row__title,
    .writeup-row::before {
      transition: none;
    }
  }
</style>
