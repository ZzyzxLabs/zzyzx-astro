---
interface ScopeItem {
  title: string;
  description: string;
}

interface ProcessItem {
  title: string;
  description: string;
}

interface EvidenceItem {
  title: string;
  description: string;
  href?: string;
  linkLabel?: string;
}

interface Props {
  statement: string;
  statementMuted: string;
  scopeTitle: string;
  scope: ScopeItem[];
  processTitle: string;
  process: ProcessItem[];
  evidenceTitle: string;
  evidenceIntro: string;
  evidence: EvidenceItem[];
  ctaTitle: string;
  ctaLabel: string;
  emailSubject: string;
}

const {
  statement,
  statementMuted,
  scopeTitle,
  scope,
  processTitle,
  process,
  evidenceTitle,
  evidenceIntro,
  evidence,
  ctaTitle,
  ctaLabel,
  emailSubject,
} = Astro.props;

const emailHref = `mailto:contact@zzyzx.com?subject=${encodeURIComponent(emailSubject)}`;
---

<main class="service-page overflow-hidden">
  <slot name="hero" />

  <section class="border-y border-[var(--shell-line)] px-5 py-20 sm:px-7 md:py-28 lg:px-10">
    <div class="mx-auto max-w-[88rem]" data-animate="fade-up">
      <p class="max-w-[30ch] font-heading text-[clamp(2rem,4vw,3.75rem)] font-medium leading-[1.08] tracking-[-0.045em] text-[var(--shell-ink)]">
        {statement} <span class="text-[var(--shell-ink-3)]">{statementMuted}</span>
      </p>
    </div>
  </section>

  <section id="scope" class="scroll-mt-20 px-5 py-24 sm:px-7 md:py-32 lg:px-10">
    <div class="mx-auto max-w-[88rem]">
      <h2 class="service-title" data-animate="fade-up">{scopeTitle}</h2>
      <div class="mt-14 grid border-t border-[var(--shell-line)] md:grid-cols-2" data-animate="fade-up">
        {scope.map((item, index) => (
          <article class:list={[
            "border-b border-white/[0.1] py-8 md:min-h-56 md:py-10",
            index % 2 === 0 ? "md:border-r md:pr-10" : "md:pl-10",
          ]}>
            <h3 class="font-heading text-2xl font-medium tracking-[-0.03em] text-[var(--shell-ink)]">{item.title}</h3>
            <p class="mt-4 max-w-lg leading-7 text-[var(--shell-ink-3)]">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-[var(--shell-line)] bg-[var(--shell-surface)] px-5 py-24 sm:px-7 md:py-28 lg:px-10">
    <div class="mx-auto max-w-[88rem]">
      <h2 class="service-title" data-animate="fade-up">{processTitle}</h2>
      <ol class:list={[
        "mt-14 grid border-y border-[var(--shell-line)]",
        process.length === 5 ? "sm:grid-cols-2 lg:grid-cols-5" : "sm:grid-cols-2 lg:grid-cols-4",
      ]} data-animate="fade-up">
        {process.map((item) => (
          <li class="border-b border-[var(--shell-line)] py-7 sm:px-6 sm:odd:border-r lg:border-b-0 lg:border-r lg:px-7 lg:last:border-r-0">
            <h3 class="font-heading text-xl font-medium tracking-[-0.025em] text-[var(--shell-ink)]">{item.title}</h3>
            <p class="mt-3 max-w-[14rem] text-sm leading-6 text-[var(--shell-ink-3)]">{item.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="px-5 py-24 sm:px-7 md:py-32 lg:px-10">
    <div class="mx-auto max-w-[88rem]">
      <header class="max-w-3xl" data-animate="fade-up">
        <h2 class="service-title">{evidenceTitle}</h2>
        <p class="service-intro mt-6">{evidenceIntro}</p>
      </header>

      <div class="mt-14 grid border-y border-[var(--shell-line)] lg:grid-cols-12" data-animate="fade-up">
        {evidence.map((item, index) => (
          <article class:list={[
            "border-b border-[var(--shell-line)] py-8 lg:min-h-72 lg:border-b-0 lg:px-8 lg:py-10",
            index === 0 ? "lg:col-span-6 lg:border-r lg:pl-0" : "lg:col-span-3 lg:border-r lg:last:border-r-0",
          ]}>
            <h3 class:list={[
              "font-heading font-medium tracking-[-0.035em] text-[var(--shell-ink)]",
              index === 0 ? "text-3xl" : "text-2xl",
            ]}>{item.title}</h3>
            <p class="mt-4 max-w-lg leading-7 text-[var(--shell-ink-3)]">{item.description}</p>
            {item.href && (
              <a href={item.href} target="_blank" rel="noreferrer" class="service-text-link mt-7 inline-flex">
                {item.linkLabel ?? "Visit project"} <span aria-hidden="true" class="ml-3">↗</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--shell-line)] px-5 py-24 sm:px-7 md:py-32 lg:px-10">
    <div class="mx-auto grid max-w-[88rem] gap-10 lg:grid-cols-12 lg:items-end" data-animate="fade-up">
      <h2 class="max-w-[18ch] font-heading text-[clamp(2.5rem,4.8vw,4.2rem)] font-medium leading-[1.04] tracking-[-0.05em] text-[var(--shell-ink)] lg:col-span-9">
        {ctaTitle}
      </h2>
      <a href={emailHref} class="service-button-primary lg:col-span-3 lg:justify-self-end">{ctaLabel}</a>
    </div>
  </section>
</main>

<style>
  .service-page {
    background: var(--shell-bg);
    color: var(--shell-ink);
  }

  /* Was an "Engagement model" eyebrow above every section heading. The heading
   * already carries it; a label repeated as section grammar is scaffolding. */

  .service-title {
    max-width: 18ch;
    font-family: var(--font-heading);
    font-size: clamp(2.35rem, 4.2vw, 3.8rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.048em;
    color: var(--shell-ink);
  }

  .service-intro {
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--shell-ink-3);
  }

  .service-button-primary,
  .service-button-secondary {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    padding: 0.75rem 1.25rem;
    white-space: nowrap;
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease, transform 220ms ease;
  }

  .service-button-primary {
    border: 1px solid var(--shell-accent);
    background: var(--shell-accent);
    color: var(--shell-on-accent);
  }

  .service-button-primary:hover {
    border-color: var(--shell-accent-ink);
    background: var(--shell-accent-ink);
    transform: translateY(-1px);
  }

  .service-button-secondary {
    border: 1px solid rgba(242, 243, 239, 0.2);
    color: var(--shell-ink-2);
  }

  .service-button-secondary:hover {
    border-color: color-mix(in srgb, var(--shell-accent) 65%, transparent);
    color: var(--shell-accent-ink);
    transform: translateY(-1px);
  }

  .service-text-link {
    border-bottom: 1px solid color-mix(in srgb, var(--shell-accent) 45%, transparent);
    padding-bottom: 0.2rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--shell-accent-ink);
    text-decoration: none;
  }

  .service-button-primary:focus-visible,
  .service-button-secondary:focus-visible,
  .service-text-link:focus-visible {
    outline: 2px solid var(--shell-accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-page :global([data-animate]) {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
