---
import WriteupRow from "./audit/WriteupRow.astro";
import { getPublishedAudits } from "../data/audits";
import "../styles/audit-writeup.css";

const auditReports = await getPublishedAudits("audit");
const incidentAnalyses = await getPublishedAudits("incident");
const ARCHIVE_PREVIEW = 4;

const archive = [
  {
    id: "incident-analysis",
    tone: "incident",
    label: "Incident analysis",
    intro: "Public exploits rebuilt from on-chain evidence, in the finding format we use for client work.",
    empty: "Incident writeups are being prepared.",
    href: "/security-audit/incidents",
    records: incidentAnalyses,
  },
  {
    id: "audit-reports",
    tone: "report",
    label: "Audit reports",
    intro: "Engagements published once the client approves disclosure. Private work stays confidential.",
    empty: "Reports appear here after a client approves public disclosure.",
    href: "/security-audit/reports",
    records: auditReports,
  },
];

const heroDocket = [
  {
    term: "Scope",
    detail: "Repository, target commit, and trust boundaries identified",
  },
  {
    term: "Review",
    detail: "Manual and AI-assisted analysis, with formal methods where suitable",
  },
  {
    term: "Record",
    detail: "Finding evidence, severity rationale, and remediation status",
  },
];

const hasPublicReports = auditReports.length + incidentAnalyses.length > 0;
const heroSecondaryHref = hasPublicReports ? "#audit-work" : "#review-method";
const heroSecondaryLabel = hasPublicReports ? "Read the writeups" : "Review methodology";

const reviewAreas = [
  {
    title: "Access and capabilities",
    description: "Privileged paths, capability ownership, visibility, and every function that can change protected state.",
  },
  {
    title: "Asset lifecycle",
    description: "Creation, transfer, wrapping, destruction, recovery, and the invariants that must survive each transition.",
  },
  {
    title: "Economic logic",
    description: "Pricing, accounting, rounding, incentives, and adversarial transaction sequences against the intended model.",
  },
  {
    title: "Integrations and upgrades",
    description: "Trust boundaries across packages, oracles, dependencies, migration paths, and operational controls.",
  },
  {
    title: "AI-assisted analysis",
    description: "Targeted agents help reviewers trace complex call paths and test more hypotheses without replacing human judgment.",
  },
  {
    title: "Formal verification",
    description: "Critical properties are specified precisely and proved against the implementation for suitable engagements.",
  },
];

const auditProcess = [
  {
    title: "Model the system",
    description: "Map actors, assets, trust boundaries, invariants, and the exact commit included in scope.",
  },
  {
    title: "Break the assumptions",
    description: "Probe authorization, state transitions, and economic edge cases with manual review, targeted tests, and formal methods.",
  },
  {
    title: "Report with evidence",
    description: "Record impact, affected code, a reproducible path, severity rationale, and a practical fix for every finding.",
  },
  {
    title: "Verify the fix",
    description: "Review the remediation commit and mark each finding as resolved, acknowledged, or still open.",
  },
];

---

<main class="audit-shell overflow-hidden">
  <section class="audit-cover" aria-labelledby="audit-hero-title">
    <div class="audit-cover__frame">
      <header class="audit-cover__mast">
        <p class="audit-label">Security Audit</p>
      </header>

      <div class="audit-cover__message">
        <h1 id="audit-hero-title">Evidence for code that holds value.</h1>
        <p class="audit-cover__intro">
          Manual review, AI-assisted analysis, adversarial testing, and formal verification for critical Web3 systems.
        </p>
        <div class="audit-cover__actions">
          <a href="mailto:contact@zzyzx.com?subject=Security%20Audit%20Inquiry" class="audit-button-primary">Request an audit</a>
          <a href={heroSecondaryHref} class="audit-button-secondary">{heroSecondaryLabel}</a>
        </div>
      </div>

      <aside class="audit-cover__ledger" aria-label="Audit engagement record">
        <dl>
          {heroDocket.map((item, index) => (
            <div class="audit-cover__entry" style={`--entry-delay: ${120 + index * 90}ms`}>
              <dt>{item.term}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  <section id="review-method" class="audit-band scroll-mt-20 px-5 py-24 sm:px-7 md:py-32 lg:px-10">
    <div class="mx-auto max-w-[88rem]">
      <header class="max-w-3xl" data-animate="fade-up">
        <p class="audit-label">Review surface</p>
        <h2 class="audit-title mt-5">We follow every path where value or authority can move.</h2>
        <p class="audit-intro mt-6">A secure language removes entire bug classes. It does not replace adversarial review of custom business logic.</p>
      </header>

      <div class="mt-16 grid border-b border-[var(--audit-line)] md:grid-cols-2" data-animate="fade-up">
        {reviewAreas.map((area, index) => (
          <article class:list={[
            "border-t border-[var(--audit-line)] py-8 md:min-h-56 md:py-10",
            index % 2 === 0 ? "md:border-r md:pr-10" : "md:pl-10",
          ]}>
            <p class="text-[0.68rem] font-medium tracking-[0.16em] text-[var(--audit-ink-4)]">0{index + 1}</p>
            <h3 class="mt-7 font-heading text-2xl font-medium tracking-[-0.03em] text-[var(--audit-ink)]">{area.title}</h3>
            <p class="mt-4 max-w-lg leading-7 text-[var(--audit-ink-3)]">{area.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="audit-work" class="scroll-mt-20 px-5 py-24 sm:px-7 md:py-28 lg:px-10">
    <div class="mx-auto max-w-[88rem]">
      <header class="archive-head" data-animate="fade-up">
        <div>
          <p class="audit-label">Public writeups</p>
          <h2 class="archive-title mt-4">Findings, written out in full.</h2>
        </div>
        <p class="archive-standfirst">
          Every writeup carries the same record: what was in scope, how the assumption broke, and what the fix was.
        </p>
      </header>

      <div class="archive-grid">
        {archive.map((group) => (
          <div id={group.id} class="archive-column scroll-mt-24" style={`--lane: var(--lane-${group.tone});`}>
            <div class="archive-column__head" data-animate="fade-up">
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <p class="audit-label">{group.label}</p>
                <p class="text-xs text-[var(--audit-ink-4)]">
                  {group.records.length} {group.records.length === 1 ? "writeup" : "writeups"}
                </p>
              </div>
              <p class="archive-column__intro">{group.intro}</p>
            </div>

            {group.records.length > 0 ? (
              <div class="archive-column__list">
                {group.records.slice(0, ARCHIVE_PREVIEW).map((record) => <WriteupRow record={record} />)}
              </div>
            ) : (
              <p class="archive-column__empty" data-animate="fade-up">{group.empty}</p>
            )}

            <div class="archive-column__foot">
              {group.records.length > 0 && (
                <a class="archive-see-all" href={group.href}>
                  <span aria-hidden="true">&gt;&gt;</span> See all {group.label.toLowerCase()}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="audit-band px-5 py-24 sm:px-7 md:py-32 lg:px-10">
    <div class="mx-auto grid max-w-[88rem] gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-animate="fade-up">
        <p class="audit-label">The process</p>
        <h2 class="audit-title mt-5">A review built for remediation.</h2>
        <p class="audit-intro mt-6">The goal is not a long finding list. It is a precise record of risk and a clear path to safer code.</p>
      </div>
      <ol class="border-b border-[var(--audit-line)] lg:col-span-7" data-animate="fade-up">
        {auditProcess.map((item, index) => (
          <li class="grid gap-5 border-t border-[var(--audit-line)] py-7 sm:grid-cols-[3.5rem_1fr] sm:py-8">
            <span class="text-xs tracking-[0.16em] text-[var(--audit-ink-4)]">0{index + 1}</span>
            <div>
              <h3 class="font-heading text-xl font-medium tracking-[-0.025em] text-[var(--audit-ink)]">{item.title}</h3>
              <p class="mt-3 max-w-xl leading-7 text-[var(--audit-ink-3)]">{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="audit-close px-5 py-24 sm:px-7 md:py-32 lg:px-10">
    <div class="mx-auto max-w-[88rem]" data-animate="fade-up">
      <p class="audit-label">Scope an engagement</p>
      <div class="mt-6 grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-9">
          <h2 class="max-w-[18ch] font-heading text-[clamp(2.5rem,4.8vw,4.2rem)] font-medium leading-[1.04] tracking-[-0.05em] text-[var(--audit-ink)]">
            Put an adversarial reviewer on the critical path.
          </h2>
          <p class="mt-6 max-w-2xl leading-7 text-[var(--audit-ink-3)]">Send the repository, target commit, documentation, and expected launch window. We will reply with scope and availability.</p>
        </div>
        <a href="mailto:contact@zzyzx.com?subject=Security%20Audit%20Inquiry" class="audit-button-primary lg:col-span-3 lg:justify-self-end">Request an audit</a>
      </div>
    </div>
  </section>
</main>

<style>
  .audit-shell {
    background: var(--audit-bg);
    color: var(--audit-ink);
  }

  /* ---------- Planes ----------
   * The page alternates between the ground and one raised band so the reader
   * can feel section boundaries without reading a heading. Before this, the
   * bands were #0b0d0f on #08090a: a 1.5% lightness step nobody can see. */
  .audit-band {
    border-block: 1px solid var(--audit-line-strong);
    background: var(--audit-bg-raised);
  }

  .audit-close {
    position: relative;
    border-top: 1px solid var(--audit-line-strong);
    background:
      radial-gradient(78% 120% at 88% 8%, color-mix(in srgb, var(--audit-cyan) 11%, transparent), transparent 62%),
      var(--audit-bg);
  }

  .audit-cover {
    position: relative;
    padding: 4.25rem 1rem 0;
    background: var(--audit-bg);
  }

  .audit-cover::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(66% 52% at 16% 34%, color-mix(in srgb, var(--audit-cyan) 10%, transparent), transparent 70%);
    pointer-events: none;
  }

  .audit-cover__frame {
    position: relative;
    display: grid;
    min-height: calc(100dvh - 4.25rem);
    max-width: 88rem;
    margin-inline: auto;
    border-inline: 1px solid var(--audit-line);
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr;
  }

  .audit-cover__mast {
    grid-column: 1 / -1;
    padding: 1rem clamp(1.25rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--audit-line);
  }

  .audit-cover__message {
    display: flex;
    flex-direction: column;
    grid-column: 1 / 9;
    justify-content: center;
    padding: clamp(3rem, 6vw, 6rem) clamp(1.5rem, 5vw, 5rem);
  }

  .audit-cover__message h1 {
    max-width: 17.5ch;
    font-family: var(--font-heading);
    font-size: clamp(3.15rem, 5.2vw, 4.6rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.038em;
    color: var(--audit-ink);
    text-wrap: balance;
  }

  .audit-cover__intro {
    max-width: 36rem;
    margin-top: 1.75rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--audit-ink-3);
  }

  .audit-cover__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* The engagement record is the one panel in the hero, so it sits two steps
   * above the ground rather than one imperceptible step. */
  .audit-cover__ledger {
    position: relative;
    grid-column: 9 / -1;
    border-left: 1px solid var(--audit-line-strong);
    background:
      linear-gradient(200deg, color-mix(in srgb, var(--audit-cyan) 7%, transparent), transparent 58%),
      var(--audit-bg-panel);
  }

  .audit-cover__ledger dl {
    display: grid;
    height: 100%;
    margin: 0;
    grid-template-rows: repeat(3, 1fr);
  }

  .audit-cover__entry {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--audit-line);
  }

  .audit-cover__entry:last-child {
    border-bottom: 0;
  }

  .audit-cover__entry dt {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--audit-cyan);
  }

  .audit-cover__entry dd {
    max-width: 22rem;
    margin: 1rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--audit-ink-2);
  }

  .audit-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lane, var(--audit-cyan));
  }

  .audit-title {
    max-width: 18ch;
    font-family: var(--font-heading);
    font-size: clamp(2.35rem, 4.2vw, 3.8rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.038em;
    color: var(--audit-ink);
    text-wrap: balance;
  }

  .audit-intro {
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--audit-ink-3);
  }

  .archive-head {
    display: grid;
    align-items: end;
    gap: 1.5rem 4rem;
    padding-bottom: 3rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .archive-title {
    max-width: 22ch;
    font-family: var(--font-heading);
    font-size: clamp(1.95rem, 3vw, 2.75rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.036em;
    color: var(--audit-ink);
    text-wrap: balance;
  }

  .archive-standfirst {
    max-width: 34rem;
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--audit-ink-3);
  }

  .archive-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* Incidents and reports are two different promises. They used to be the same
   * cyan eyebrow over the same black column; now each lane owns a tone. */
  .archive-column {
    position: relative;
    display: flex;
    flex-direction: column;
    border-top: 2px solid var(--lane);
    padding: 2.5rem 0 0;
  }

  .archive-column::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 13rem;
    background: linear-gradient(180deg, color-mix(in srgb, var(--lane) 9%, transparent), transparent);
    pointer-events: none;
  }

  .archive-column > * {
    position: relative;
  }

  .archive-column__intro {
    max-width: 32rem;
    margin-top: 0.9rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--audit-ink-3);
  }

  .archive-column__list {
    margin-top: 2rem;
  }

  .archive-column__empty {
    margin-top: 2rem;
    border-top: 1px solid var(--audit-line);
    padding-top: 1.35rem;
    max-width: 30rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--audit-ink-3);
  }

  .archive-column__foot {
    margin-top: auto;
    border-top: 1px solid var(--audit-line);
    padding-top: 1.5rem;
  }

  .archive-see-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--audit-cyan-ink);
    text-decoration: none;
    transition: gap 200ms ease;
  }

  .archive-see-all span {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    color: var(--lane, var(--audit-cyan));
  }

  .archive-see-all:hover {
    gap: 0.85rem;
  }

  .archive-see-all:focus-visible {
    outline: 2px solid var(--audit-cyan);
    outline-offset: 4px;
  }

  @media (min-width: 900px) {
    .archive-head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }

    .archive-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .archive-column:first-child {
      padding-right: 3.5rem;
    }

    .archive-column:last-child {
      border-left: 1px solid var(--audit-line);
      padding-left: 3.5rem;
    }
  }

  @media (max-width: 899px) {
    .archive-column + .archive-column {
      margin-top: 3rem;
    }

    .archive-column__foot {
      padding-bottom: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-see-all {
      transition: none;
    }
  }

  .audit-button-primary,
  .audit-button-secondary {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    padding: 0.75rem 1.25rem;
    white-space: nowrap;
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease, transform 220ms ease;
  }

  .audit-button-primary {
    border: 1px solid var(--audit-cyan);
    background: var(--audit-cyan);
    color: #071012;
  }

  .audit-button-primary:hover {
    border-color: var(--audit-cyan-bright);
    background: var(--audit-cyan-bright);
    transform: translateY(-1px);
  }

  .audit-button-secondary {
    border: 1px solid var(--audit-line-strong);
    color: var(--audit-ink-2);
  }

  .audit-button-secondary:hover {
    border-color: color-mix(in srgb, var(--audit-cyan) 65%, transparent);
    background: var(--audit-bg-hover);
    color: var(--audit-cyan-bright);
    transform: translateY(-1px);
  }

  .audit-text-link {
    border-bottom: 1px solid color-mix(in srgb, var(--audit-cyan) 45%, transparent);
    padding-bottom: 0.2rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--audit-cyan-ink);
    text-decoration: none;
  }

  .audit-text-link.muted {
    border-color: var(--audit-line);
    color: var(--audit-ink-3);
  }

  .audit-button-primary:focus-visible,
  .audit-button-secondary:focus-visible,
  .audit-text-link:focus-visible {
    outline: 2px solid var(--audit-cyan);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .audit-cover__message {
      animation: audit-message-in 820ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .audit-cover__entry {
      animation: audit-entry-in 780ms var(--entry-delay) cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  @keyframes audit-message-in {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes audit-entry-in {
    from { opacity: 0; transform: translateX(14px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @media (min-width: 640px) {
    .audit-cover {
      padding-inline: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .audit-cover {
      padding-inline: 2.5rem;
    }
  }

  @media (max-width: 767px) {
    .audit-cover__frame {
      display: block;
      min-height: auto;
    }

    .audit-cover__message {
      min-height: calc(100dvh - 8rem);
      padding: 3rem 1.25rem 3.5rem;
    }

    .audit-cover__message h1 {
      font-size: clamp(2.9rem, 13vw, 3.65rem);
    }

    .audit-cover__actions {
      flex-direction: column;
    }

    .audit-button-primary,
    .audit-button-secondary {
      width: 100%;
      min-height: 3rem;
    }

    .audit-cover__ledger {
      border-top: 1px solid var(--audit-line-strong);
      border-left: 0;
    }

    .audit-cover__ledger dl {
      display: block;
    }

    .audit-cover__entry {
      min-height: 9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .audit-button-primary,
    .audit-button-secondary,
    .audit-text-link {
      transition: none;
    }

    .audit-shell :global([data-animate]) {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
