---
import { publishedAudits } from "../data/audits";

const heroDocket = [
  {
    term: "Scope",
    detail: "Repository, target commit, and trust boundaries identified",
  },
  {
    term: "Review",
    detail: "Manual and AI-assisted analysis, with formal methods where suitable",
  },
  {
    term: "Record",
    detail: "Finding evidence, severity rationale, and remediation status",
  },
];

const hasPublicReports = publishedAudits.length > 0;
const heroSecondaryHref = hasPublicReports ? "#audit-work" : "#review-method";
const heroSecondaryLabel = hasPublicReports ? "View public reports" : "Review methodology";

const reviewAreas = [
  {
    title: "Access and capabilities",
    description: "Privileged paths, capability ownership, visibility, and every function that can change protected state.",
  },
  {
    title: "Asset lifecycle",
    description: "Creation, transfer, wrapping, destruction, recovery, and the invariants that must survive each transition.",
  },
  {
    title: "Economic logic",
    description: "Pricing, accounting, rounding, incentives, and adversarial transaction sequences against the intended model.",
  },
  {
    title: "Integrations and upgrades",
    description: "Trust boundaries across packages, oracles, dependencies, migration paths, and operational controls.",
  },
  {
    title: "AI-assisted analysis",
    description: "Targeted agents help reviewers trace complex call paths and test more hypotheses without replacing human judgment.",
  },
  {
    title: "Formal verification",
    description: "Critical properties are specified precisely and proved against the implementation for suitable engagements.",
  },
];

const auditProcess = [
  {
    title: "Model the system",
    description: "Map actors, assets, trust boundaries, invariants, and the exact commit included in scope.",
  },
  {
    title: "Break the assumptions",
    description: "Probe authorization, state transitions, and economic edge cases with manual review, targeted tests, and formal methods.",
  },
  {
    title: "Report with evidence",
    description: "Record impact, affected code, a reproducible path, severity rationale, and a practical fix for every finding.",
  },
  {
    title: "Verify the fix",
    description: "Review the remediation commit and mark each finding as resolved, acknowledged, or still open.",
  },
];

const findingLabels = {
  critical: "Critical",
  high: "High",
  medium: "Medium",
  low: "Low",
  informational: "Informational",
} as const;
---

<main class="audit-shell overflow-hidden">
  <section class="audit-cover" aria-labelledby="audit-hero-title">
    <div class="audit-cover__frame">
      <header class="audit-cover__mast">
        <p class="audit-label">Security Audit</p>
      </header>

      <div class="audit-cover__message">
        <h1 id="audit-hero-title">Evidence for code that holds value.</h1>
        <p class="audit-cover__intro">
          Manual review, AI-assisted analysis, adversarial testing, and formal verification for critical Web3 systems.
        </p>
        <div class="audit-cover__actions">
          <a href="mailto:contact@zzyzx.com?subject=Security%20Audit%20Inquiry" class="audit-button-primary">Request an audit</a>
          <a href={heroSecondaryHref} class="audit-button-secondary">{heroSecondaryLabel}</a>
        </div>
      </div>

      <aside class="audit-cover__ledger" aria-label="Audit engagement record">
        <dl>
          {heroDocket.map((item, index) => (
            <div class="audit-cover__entry" style={`--entry-delay: ${120 + index * 90}ms`}>
              <dt>{item.term}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  <section id="review-method" class="scroll-mt-20 border-y border-white/[0.09] bg-[#0b0d0f] px-5 py-24 sm:px-7 md:py-32 lg:px-10">
    <div class="mx-auto max-w-[88rem]">
      <header class="max-w-3xl" data-animate="fade-up">
        <p class="audit-label">Review surface</p>
        <h2 class="audit-title mt-5">We follow every path where value or authority can move.</h2>
        <p class="audit-intro mt-6">A secure language removes entire bug classes. It does not replace adversarial review of custom business logic.</p>
      </header>

      <div class="mt-16 grid border-b border-white/[0.11] md:grid-cols-2" data-animate="fade-up">
        {reviewAreas.map((area, index) => (
          <article class:list={[
            "border-t border-white/[0.11] py-8 md:min-h-56 md:py-10",
            index % 2 === 0 ? "md:border-r md:pr-10" : "md:pl-10",
          ]}>
            <p class="text-[0.68rem] font-medium tracking-[0.16em] text-[#535c63]">0{index + 1}</p>
            <h3 class="mt-7 font-heading text-2xl font-medium tracking-[-0.03em] text-[#e9ece8]">{area.title}</h3>
            <p class="mt-4 max-w-lg leading-7 text-[#818a91]">{area.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="audit-work" class="scroll-mt-20 px-5 py-24 sm:px-7 md:py-32 lg:px-10">
    <div class="mx-auto max-w-[88rem]">
      <header class="max-w-3xl" data-animate="fade-up">
        <p class="audit-label">Public audit archive</p>
        <h2 class="audit-title mt-5">Reviewed work, published with permission.</h2>
        <p class="audit-intro mt-6">Reports appear here only after the client approves public disclosure.</p>
      </header>

      {publishedAudits.length > 0 ? (
        <div class="mt-16 grid border-b border-white/[0.11] lg:grid-cols-2">
          {publishedAudits.map((audit, index) => (
            <article class:list={[
              "border-t border-white/[0.11] py-9",
              index % 2 === 0 ? "lg:border-r lg:pr-10" : "lg:pl-10",
            ]} data-animate="fade-up">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="audit-label">{audit.ecosystem}</p>
                  <h3 class="mt-4 font-heading text-3xl font-medium tracking-[-0.035em] text-[#eceeeb]">{audit.project}</h3>
                </div>
                <p class="text-xs text-[#707980]">{audit.completedAt}</p>
              </div>
              <p class="mt-5 max-w-xl leading-7 text-[#8b949a]">{audit.summary}</p>
              <p class="mt-6 text-sm leading-7 text-[#a8afb4]">{audit.scope.join(" / ")}</p>
              {audit.findings && (
                <dl class="mt-8 grid grid-cols-2 gap-5 border-t border-white/[0.09] pt-6 sm:grid-cols-5">
                  {Object.entries(audit.findings).map(([severity, count]) => (
                    <div>
                      <dt class="text-[0.68rem] text-[#626b72]">{findingLabels[severity as keyof typeof findingLabels]}</dt>
                      <dd class="mt-1 font-heading text-lg text-[#e5e8e5]">{count}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {(audit.reportUrl || audit.projectUrl) && (
                <div class="mt-8 flex flex-wrap gap-6">
                  {audit.reportUrl && <a class="audit-text-link" href={audit.reportUrl} target="_blank" rel="noreferrer">Read report ↗</a>}
                  {audit.projectUrl && <a class="audit-text-link muted" href={audit.projectUrl} target="_blank" rel="noreferrer">Visit project ↗</a>}
                </div>
              )}
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-16 grid border-y border-white/[0.11] py-9 lg:grid-cols-12 lg:items-center lg:py-12" data-animate="fade-up">
          <div class="lg:col-span-8">
            <h3 class="font-heading text-2xl font-medium tracking-[-0.03em] text-[#e9ece8]">Public reports are being prepared.</h3>
            <p class="mt-4 max-w-xl leading-7 text-[#818a91]">Client names and reports will be added after disclosure approval. Private engagements remain confidential.</p>
          </div>
          <p class="mt-8 text-[0.68rem] font-medium uppercase leading-6 tracking-[0.18em] text-[#687178] lg:col-span-4 lg:mt-0 lg:text-right">
            Disclosure first<br />Evidence attached<br />Scope identified
          </p>
        </div>
      )}
    </div>
  </section>

  <section class="border-y border-white/[0.09] bg-[#0b0d0f] px-5 py-24 sm:px-7 md:py-32 lg:px-10">
    <div class="mx-auto grid max-w-[88rem] gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-animate="fade-up">
        <p class="audit-label">The process</p>
        <h2 class="audit-title mt-5">A review built for remediation.</h2>
        <p class="audit-intro mt-6">The goal is not a long finding list. It is a precise record of risk and a clear path to safer code.</p>
      </div>
      <ol class="border-b border-white/[0.11] lg:col-span-7" data-animate="fade-up">
        {auditProcess.map((item, index) => (
          <li class="grid gap-5 border-t border-white/[0.11] py-7 sm:grid-cols-[3.5rem_1fr] sm:py-8">
            <span class="text-xs tracking-[0.16em] text-[#515a61]">0{index + 1}</span>
            <div>
              <h3 class="font-heading text-xl font-medium tracking-[-0.025em] text-[#e7eae7]">{item.title}</h3>
              <p class="mt-3 max-w-xl leading-7 text-[#818a91]">{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="px-5 py-24 sm:px-7 md:py-32 lg:px-10">
    <div class="mx-auto max-w-[88rem]" data-animate="fade-up">
      <p class="audit-label">Scope an engagement</p>
      <div class="mt-6 grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-9">
          <h2 class="max-w-[18ch] font-heading text-[clamp(2.5rem,4.8vw,4.2rem)] font-medium leading-[1.04] tracking-[-0.05em] text-[#edf0ec]">
            Put an adversarial reviewer on the critical path.
          </h2>
          <p class="mt-6 max-w-2xl leading-7 text-[#8b949a]">Send the repository, target commit, documentation, and expected launch window. We will reply with scope and availability.</p>
        </div>
        <a href="mailto:contact@zzyzx.com?subject=Security%20Audit%20Inquiry" class="audit-button-primary lg:col-span-3 lg:justify-self-end">Request an audit</a>
      </div>
    </div>
  </section>
</main>

<style>
  .audit-shell {
    background: #08090a;
    color: #f1f3f0;
  }

  .audit-cover {
    padding: 4.25rem 1rem 0;
    background: #08090a;
  }

  .audit-cover__frame {
    display: grid;
    min-height: calc(100dvh - 4.25rem);
    max-width: 88rem;
    margin-inline: auto;
    border-inline: 1px solid rgba(255, 255, 255, 0.1);
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr;
  }

  .audit-cover__mast {
    grid-column: 1 / -1;
    padding: 1rem clamp(1.25rem, 3vw, 2.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .audit-cover__message {
    display: flex;
    flex-direction: column;
    grid-column: 1 / 9;
    justify-content: center;
    padding: clamp(3rem, 6vw, 6rem) clamp(1.5rem, 5vw, 5rem);
  }

  .audit-cover__message h1 {
    max-width: 17.5ch;
    font-family: var(--font-heading);
    font-size: clamp(3.15rem, 5.2vw, 4.6rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.055em;
    color: #f1f3f0;
  }

  .audit-cover__intro {
    max-width: 36rem;
    margin-top: 1.75rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #969ea4;
  }

  .audit-cover__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .audit-cover__ledger {
    grid-column: 9 / -1;
    border-left: 1px solid rgba(255, 255, 255, 0.11);
    background: #0b0d0f;
  }

  .audit-cover__ledger dl {
    display: grid;
    height: 100%;
    margin: 0;
    grid-template-rows: repeat(3, 1fr);
  }

  .audit-cover__entry {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .audit-cover__entry:last-child {
    border-bottom: 0;
  }

  .audit-cover__entry dt {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #74d7dd;
  }

  .audit-cover__entry dd {
    max-width: 22rem;
    margin: 1rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    line-height: 1.5;
    color: #dfe3df;
  }

  .audit-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #74d7dd;
  }

  .audit-title {
    max-width: 18ch;
    font-family: var(--font-heading);
    font-size: clamp(2.35rem, 4.2vw, 3.8rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.048em;
    color: #edf0ec;
  }

  .audit-intro {
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #8b949a;
  }

  .audit-button-primary,
  .audit-button-secondary {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    padding: 0.75rem 1.25rem;
    white-space: nowrap;
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease, transform 220ms ease;
  }

  .audit-button-primary {
    border: 1px solid #74d7dd;
    background: #74d7dd;
    color: #071012;
  }

  .audit-button-primary:hover {
    border-color: #a3e6e9;
    background: #a3e6e9;
    transform: translateY(-1px);
  }

  .audit-button-secondary {
    border: 1px solid rgba(242, 243, 239, 0.2);
    color: #d7dad7;
  }

  .audit-button-secondary:hover {
    border-color: rgba(116, 215, 221, 0.65);
    color: #a3e6e9;
    transform: translateY(-1px);
  }

  .audit-text-link {
    border-bottom: 1px solid rgba(116, 215, 221, 0.45);
    padding-bottom: 0.2rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: #9de2e6;
    text-decoration: none;
  }

  .audit-text-link.muted {
    border-color: rgba(255, 255, 255, 0.18);
    color: #a8afb4;
  }

  .audit-button-primary:focus-visible,
  .audit-button-secondary:focus-visible,
  .audit-text-link:focus-visible {
    outline: 2px solid #74d7dd;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .audit-cover__message {
      animation: audit-message-in 820ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .audit-cover__entry {
      animation: audit-entry-in 780ms var(--entry-delay) cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  @keyframes audit-message-in {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes audit-entry-in {
    from { opacity: 0; transform: translateX(14px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @media (min-width: 640px) {
    .audit-cover {
      padding-inline: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .audit-cover {
      padding-inline: 2.5rem;
    }
  }

  @media (max-width: 767px) {
    .audit-cover__frame {
      display: block;
      min-height: auto;
    }

    .audit-cover__message {
      min-height: calc(100dvh - 8rem);
      padding: 3rem 1.25rem 3.5rem;
    }

    .audit-cover__message h1 {
      font-size: clamp(2.9rem, 13vw, 3.65rem);
    }

    .audit-cover__actions {
      flex-direction: column;
    }

    .audit-button-primary,
    .audit-button-secondary {
      width: 100%;
      min-height: 3rem;
    }

    .audit-cover__ledger {
      border-top: 1px solid rgba(255, 255, 255, 0.11);
      border-left: 0;
    }

    .audit-cover__ledger dl {
      display: block;
    }

    .audit-cover__entry {
      min-height: 9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .audit-button-primary,
    .audit-button-secondary,
    .audit-text-link {
      transition: none;
    }

    .audit-shell :global([data-animate]) {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
