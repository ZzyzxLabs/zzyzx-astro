---
import { Image } from "astro:assets";
import markLight from "../assets/zzyzx-mark-light.png";
import markDark from "../assets/zzyzx-mark-dark.png";

/**
 * The Zzyzx hourglass mark, in the two variants the brand ships.
 *
 * An earlier pass inlined `public/favicon.svg` here on the assumption it was
 * the brand mark. It is Astro's default starter favicon, so the site wore the
 * framework's logo. The real artwork is the only source now; the mark is not
 * redrawn or traced, because a subtly wrong logo costs more than the bytes.
 *
 * Both variants ship because the mark is artwork, not a glyph: the shell is
 * dark and the security document surface is light, and `filter: invert()` on
 * a real logo is the kind of shortcut that eventually bites.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const SIZE = 64;
---

<span class:list={["brand-mark", className]}>
  <Image
    class="brand-mark__art brand-mark__art--light"
    src={markLight}
    alt=""
    width={SIZE}
    height={SIZE}
    densities={[1, 2]}
    loading="eager"
  />
  <Image
    class="brand-mark__art brand-mark__art--dark"
    src={markDark}
    alt=""
    width={SIZE}
    height={SIZE}
    densities={[1, 2]}
    loading="eager"
  />
</span>

<style>
  .brand-mark {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
  }

  .brand-mark__art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* The dark-ink mark only appears where the ground is light. */
  .brand-mark__art--dark {
    display: none;
  }

  :global([data-surface="audit"]) .brand-mark__art--light {
    display: none;
  }

  :global([data-surface="audit"]) .brand-mark__art--dark {
    display: block;
  }
</style>
