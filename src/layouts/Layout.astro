---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import Navbar from "../components/Navbar.astro";
import "@fontsource-variable/archivo";
import "@fontsource-variable/literata";

interface Props {
	title?: string;
	description?: string;
	image?: string | null;
	/** The security writeups are a printed document surface; the chrome follows. */
	surface?: "shell" | "audit";
	/** Routes nothing links to should not be indexed while they are unfinished. */
	noindex?: boolean;
}

const {
	title = "Zzyzx Labs | One-Stop Web3 x AI Solutions",
	description = "GTM strategy, product engineering, AI-assisted security audits, and formal verification for Web3 and AI teams.",
	image = "/zzyzx-system-hero-v2.webp",
	surface = "shell",
	noindex = false,
} = Astro.props;

const themeColor = surface === "audit" ? "#f3f5f7" : "#08090a";
const canonicalUrl = new URL(Astro.url.pathname, "https://zzyzxlabs.com").href;
const socialImage = image ? new URL(image, "https://zzyzxlabs.com").href : null;
---

<html lang="en" data-surface={surface}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- public/favicon.svg is Astro's starter logo, not this brand's mark. -->
		<link rel="icon" href="/zzyzx.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/zzyzx-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="theme-color" content={themeColor} />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		{socialImage && <meta property="og:image" content={socialImage} />}
		<meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImage && <meta name="twitter:image" content={socialImage} />}
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<Navbar />
		<div id="main-content" tabindex="-1"><slot /></div>
		<SiteFooter />
		<script>
			import "../scripts/scroll-animations";
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<style is:global>
	.skip-link {
		position: fixed;
		z-index: 200;
		top: 0.75rem;
		left: 0.75rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--shell-accent);
		background: var(--shell-bg);
		color: var(--shell-ink);
		font-size: 0.875rem;
		text-decoration: none;
		transform: translateY(-180%);
	}

	.skip-link:focus {
		transform: translateY(0);
		outline: 2px solid var(--shell-accent);
		outline-offset: 3px;
	}
</style>
